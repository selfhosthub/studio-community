{
  "$schema": "https://raw.githubusercontent.com/selfhosthub/studio-community/main/schemas/comfyui-workflow.schema.json",
  "slug": "shs/comfyui-txt2img-flux1-schnell",
  "version": "1.1.0",
  "name": "ComfyUI Text to Image (Flux.1 Schnell)",
  "description": "Generate images from text prompts with Flux.1 Schnell (bf16 or FP8) in ComfyUI.",
  "author": "SelfHostHub",
  "service": {
    "id": "comfyui_txt2img",
    "queue": "comfyui_image_jobs",
    "media": "image"
  },
  "models": [
    {
      "id": "flux1-schnell",
      "label": "Flux.1 Schnell (fast, 1 step)",
      "assignments": [
        {
          "node": "26",
          "path": "inputs.guidance",
          "value": 3.5
        }
      ],
      "required_models": [
        "flux1-schnell.safetensors",
        "t5xxl_fp16.safetensors",
        "clip_l.safetensors",
        "ae.safetensors"
      ]
    },
    {
      "id": "flux1-schnell-fp8",
      "label": "Flux.1 Schnell FP8",
      "assignments": [
        {
          "node": "12",
          "path": "inputs.unet_name",
          "value": "flux1-schnell-fp8-e4m3fn.safetensors"
        },
        {
          "node": "11",
          "path": "inputs.clip_name1",
          "value": "t5xxl_fp8_e4m3fn.safetensors"
        },
        {
          "node": "26",
          "path": "inputs.guidance",
          "value": 3.5
        }
      ],
      "required_models": [
        "flux1-schnell-fp8-e4m3fn.safetensors",
        "t5xxl_fp8_e4m3fn.safetensors",
        "clip_l.safetensors",
        "ae.safetensors"
      ]
    }
  ],
  "capabilities": {
    "negative_prompt": false,
    "upscale": true,
    "lora": false,
    "batch": true,
    "style_presets": true
  },
  "parameters": {
    "prompt": {
      "type": "string",
      "required": true,
      "ui": {
        "section": "basic",
        "rows": 4
      }
    },
    "styles": {
      "type": "array",
      "scope": "api",
      "default": [
        "sai-comic book"
      ],
      "ui": {
        "section": "basic",
        "widget": "multiselect"
      }
    },
    "style_merge": {
      "type": "enum",
      "scope": "api",
      "default": "nested",
      "options": [
        "nested",
        "stacked",
        "blended",
        "minimal"
      ]
    },
    "seed": {
      "type": "integer",
      "default": -1
    },
    "steps": {
      "type": "integer",
      "default": 1,
      "min": 1,
      "max": 8
    },
    "batch_size": {
      "type": "integer",
      "default": 1,
      "min": 1,
      "max": 4
    },
    "dimensions": {
      "type": "enum",
      "default": "1920x1080",
      "options": [
        {
          "value": "1024x1024",
          "label": "1:1 - 1024x1024"
        },
        {
          "value": "1920x1080",
          "label": "16:9 - 1920x1080"
        },
        {
          "value": "1080x1920",
          "label": "9:16 - 1080x1920"
        },
        {
          "value": "1536x1024",
          "label": "3:2 - 1536x1024"
        },
        {
          "value": "1024x1536",
          "label": "2:3 - 1024x1536"
        }
      ]
    },
    "upscale": {
      "type": "boolean",
      "default": true,
      "title": "Fast Mode"
    },
    "upscale_method": {
      "type": "enum",
      "default": "lanczos",
      "options": [
        "lanczos",
        "bicubic",
        "bilinear",
        "nearest-exact",
        "area"
      ],
      "when": "upscale"
    }
  },
  "generation": {
    "min_side": 512,
    "max_side": 2048,
    "snap": 64
  },
  "node_mappings": {
    "prompt": [
      {
        "node": "6",
        "path": "inputs.text"
      }
    ],
    "seed": [
      {
        "node": "25",
        "path": "inputs.noise_seed"
      }
    ],
    "steps": [
      {
        "node": "17",
        "path": "inputs.steps"
      }
    ],
    "batch_size": [
      {
        "node": "27",
        "path": "inputs.batch_size"
      }
    ],
    "width": [
      {
        "node": "27",
        "path": "inputs.width"
      },
      {
        "node": "30",
        "path": "inputs.width"
      }
    ],
    "height": [
      {
        "node": "27",
        "path": "inputs.height"
      },
      {
        "node": "30",
        "path": "inputs.height"
      }
    ],
    "output_width": [
      {
        "node": "50",
        "path": "inputs.width"
      }
    ],
    "output_height": [
      {
        "node": "50",
        "path": "inputs.height"
      }
    ],
    "upscale_method": [
      {
        "node": "50",
        "path": "inputs.upscale_method"
      }
    ]
  },
  "outputs": [
    {
      "media": "image",
      "node": "9",
      "class": "SaveImage"
    }
  ],
  "required_models": [
    {
      "filename": "flux1-schnell.safetensors",
      "directory": "diffusion_models",
      "size_gb": 23.8,
      "source_url": "https://huggingface.co/black-forest-labs/FLUX.1-schnell",
      "license": "apache-2.0",
      "access": "open"
    },
    {
      "filename": "t5xxl_fp16.safetensors",
      "directory": "text_encoders",
      "size_gb": 9.8,
      "source_url": "https://huggingface.co/comfyanonymous/flux_text_encoders",
      "license": "apache-2.0",
      "access": "open"
    },
    {
      "filename": "clip_l.safetensors",
      "directory": "text_encoders",
      "size_gb": 0.2,
      "source_url": "https://huggingface.co/comfyanonymous/flux_text_encoders",
      "license": "mit",
      "access": "open"
    },
    {
      "filename": "ae.safetensors",
      "directory": "vae",
      "size_gb": 0.3,
      "source_url": "https://huggingface.co/black-forest-labs/FLUX.1-schnell",
      "license": "apache-2.0",
      "access": "open"
    },
    {
      "filename": "flux1-schnell-fp8-e4m3fn.safetensors",
      "directory": "diffusion_models",
      "size_gb": 11.9,
      "source_url": "https://huggingface.co/Kijai/flux-fp8",
      "license": "apache-2.0",
      "access": "open"
    },
    {
      "filename": "t5xxl_fp8_e4m3fn.safetensors",
      "directory": "text_encoders",
      "size_gb": 4.9,
      "source_url": "https://huggingface.co/comfyanonymous/flux_text_encoders",
      "license": "apache-2.0",
      "access": "open"
    }
  ],
  "graph": {
    "6": {
      "inputs": {
        "text": "a cat",
        "clip": [
          "11",
          0
        ]
      },
      "class_type": "CLIPTextEncode"
    },
    "8": {
      "inputs": {
        "samples": [
          "13",
          0
        ],
        "vae": [
          "10",
          0
        ]
      },
      "class_type": "VAEDecode"
    },
    "9": {
      "inputs": {
        "filename_prefix": "ComfyUI",
        "images": [
          "50",
          0
        ]
      },
      "class_type": "SaveImage"
    },
    "10": {
      "inputs": {
        "vae_name": "ae.safetensors"
      },
      "class_type": "VAELoader"
    },
    "11": {
      "inputs": {
        "clip_name1": "t5xxl_fp16.safetensors",
        "clip_name2": "clip_l.safetensors",
        "type": "flux"
      },
      "class_type": "DualCLIPLoader"
    },
    "12": {
      "inputs": {
        "unet_name": "flux1-schnell.safetensors",
        "weight_dtype": "default"
      },
      "class_type": "UNETLoader"
    },
    "13": {
      "inputs": {
        "noise": [
          "25",
          0
        ],
        "guider": [
          "22",
          0
        ],
        "sampler": [
          "16",
          0
        ],
        "sigmas": [
          "17",
          0
        ],
        "latent_image": [
          "27",
          0
        ]
      },
      "class_type": "SamplerCustomAdvanced"
    },
    "16": {
      "inputs": {
        "sampler_name": "euler"
      },
      "class_type": "KSamplerSelect"
    },
    "17": {
      "inputs": {
        "scheduler": "simple",
        "steps": 1,
        "denoise": 1,
        "model": [
          "30",
          0
        ]
      },
      "class_type": "BasicScheduler"
    },
    "22": {
      "inputs": {
        "model": [
          "30",
          0
        ],
        "conditioning": [
          "26",
          0
        ]
      },
      "class_type": "BasicGuider"
    },
    "25": {
      "inputs": {
        "noise_seed": 0
      },
      "class_type": "RandomNoise"
    },
    "26": {
      "inputs": {
        "guidance": 7.5,
        "conditioning": [
          "6",
          0
        ]
      },
      "class_type": "FluxGuidance"
    },
    "27": {
      "inputs": {
        "width": 512,
        "height": 512,
        "batch_size": 1
      },
      "class_type": "EmptySD3LatentImage"
    },
    "30": {
      "inputs": {
        "max_shift": 1.15,
        "base_shift": 0.5,
        "width": 512,
        "height": 512,
        "model": [
          "12",
          0
        ]
      },
      "class_type": "ModelSamplingFlux"
    },
    "50": {
      "inputs": {
        "upscale_method": "lanczos",
        "width": 512,
        "height": 512,
        "crop": "disabled",
        "image": [
          "8",
          0
        ]
      },
      "class_type": "ImageScale"
    }
  }
}
