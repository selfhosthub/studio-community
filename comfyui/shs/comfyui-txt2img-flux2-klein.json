{
  "$schema": "https://raw.githubusercontent.com/selfhosthub/studio-community/main/schemas/comfyui-workflow.schema.json",
  "slug": "shs/comfyui-txt2img-flux2-klein",
  "version": "1.2.0",
  "name": "ComfyUI Text to Image (Flux 2 Klein)",
  "description": "Generate images from text prompts using the Flux 2 Klein 4B or 9B model in ComfyUI. The model parameter selects the weights.",
  "author": "SelfHostHub",
  "service": {
    "id": "comfyui_txt2img",
    "queue": "comfyui_image_jobs",
    "media": "image"
  },
  "models": [
    {
      "id": "flux-2-klein-4b",
      "label": "Flux 2 Klein 4B (quality, 8 steps)",
      "defaults": {
        "steps": 8
      },
      "assignments": [
        {
          "node": "3",
          "path": "inputs.unet_name",
          "value": "flux-2-klein-4b.safetensors"
        },
        {
          "node": "4",
          "path": "inputs.clip_name",
          "value": "qwen_3_4b.safetensors"
        }
      ],
      "required_models": [
        "flux-2-klein-4b.safetensors",
        "qwen_3_4b.safetensors",
        "flux2-vae.safetensors"
      ]
    },
    {
      "id": "flux-2-klein-9b",
      "label": "Flux 2 Klein 9B (best quality, 8 steps)",
      "defaults": {
        "steps": 8
      },
      "assignments": [
        {
          "node": "3",
          "path": "inputs.unet_name",
          "value": "flux-2-klein-9b-fp8.safetensors"
        },
        {
          "node": "4",
          "path": "inputs.clip_name",
          "value": "qwen_3_8b_fp8mixed.safetensors"
        }
      ],
      "required_models": [
        "flux-2-klein-9b-fp8.safetensors",
        "qwen_3_8b_fp8mixed.safetensors",
        "flux2-vae.safetensors"
      ]
    }
  ],
  "capabilities": {
    "negative_prompt": true,
    "upscale": true,
    "lora": false,
    "batch": true,
    "style_presets": true
  },
  "parameters": {
    "prompt": {
      "type": "string",
      "required": true,
      "ui": {
        "section": "basic",
        "rows": 4
      }
    },
    "styles": {
      "type": "array",
      "scope": "api",
      "default": [
        "sai-comic book"
      ],
      "ui": {
        "section": "basic",
        "widget": "multiselect"
      }
    },
    "style_merge": {
      "type": "enum",
      "scope": "api",
      "default": "nested",
      "options": [
        "nested",
        "stacked",
        "blended",
        "minimal"
      ]
    },
    "seed": {
      "type": "integer",
      "default": -1
    },
    "steps": {
      "type": "integer",
      "default": 1,
      "min": 1,
      "max": 8
    },
    "batch_size": {
      "type": "integer",
      "default": 1,
      "min": 1,
      "max": 4
    },
    "dimensions": {
      "type": "string",
      "default": "1920x1080",
      "pattern": "^\\d{2,5}x\\d{2,5}$",
      "suggestions": [
        "1920x1080",
        "1080x1920",
        "1024x1024",
        "1536x1024",
        "1024x1536",
        "1344x768",
        "768x1344"
      ]
    },
    "upscale": {
      "type": "boolean",
      "default": true,
      "title": "Fast Mode"
    },
    "upscale_method": {
      "type": "enum",
      "default": "lanczos",
      "options": [
        "lanczos",
        "bicubic",
        "bilinear",
        "nearest-exact",
        "area"
      ],
      "when": "upscale"
    },
    "negative_prompt": {
      "type": "string",
      "default": "",
      "ui": {
        "section": "basic",
        "rows": 2
      }
    }
  },
  "generation": {
    "min_side": 512,
    "max_side": 2048,
    "snap": 64
  },
  "node_mappings": {
    "prompt": [
      {
        "node": "6",
        "path": "inputs.text"
      }
    ],
    "negative_prompt": [
      {
        "node": "7",
        "path": "inputs.text"
      }
    ],
    "seed": [
      {
        "node": "14",
        "path": "inputs.noise_seed"
      }
    ],
    "steps": [
      {
        "node": "12",
        "path": "inputs.steps"
      }
    ],
    "batch_size": [
      {
        "node": "11",
        "path": "inputs.batch_size"
      }
    ],
    "width": [
      {
        "node": "11",
        "path": "inputs.width"
      },
      {
        "node": "12",
        "path": "inputs.width"
      }
    ],
    "height": [
      {
        "node": "11",
        "path": "inputs.height"
      },
      {
        "node": "12",
        "path": "inputs.height"
      }
    ],
    "output_width": [
      {
        "node": "50",
        "path": "inputs.width"
      }
    ],
    "output_height": [
      {
        "node": "50",
        "path": "inputs.height"
      }
    ],
    "upscale_method": [
      {
        "node": "50",
        "path": "inputs.upscale_method"
      }
    ]
  },
  "outputs": [
    {
      "media": "image",
      "node": "18",
      "class": "SaveImage"
    }
  ],
  "requires_comfyui": ">=0.3.40",
  "required_models": [
    {
      "filename": "flux-2-klein-4b.safetensors",
      "directory": "diffusion_models",
      "size_gb": 7.8,
      "source_url": "https://huggingface.co/black-forest-labs/FLUX.2-klein-4B",
      "license": "apache-2.0",
      "access": "gated"
    },
    {
      "filename": "flux-2-klein-9b-fp8.safetensors",
      "directory": "diffusion_models",
      "size_gb": 9.4,
      "source_url": "https://huggingface.co/black-forest-labs/FLUX.2-klein-9B",
      "license": "apache-2.0",
      "access": "gated"
    },
    {
      "filename": "qwen_3_4b.safetensors",
      "directory": "text_encoders",
      "size_gb": 8.0,
      "source_url": "https://huggingface.co/Comfy-Org/vae-text-encorder-for-flux-klein-4b",
      "license": "apache-2.0",
      "access": "open"
    },
    {
      "filename": "qwen_3_8b_fp8mixed.safetensors",
      "directory": "text_encoders",
      "size_gb": 8.7,
      "source_url": "https://huggingface.co/Comfy-Org/vae-text-encorder-for-flux-klein-9b",
      "license": "apache-2.0",
      "access": "open"
    },
    {
      "filename": "flux2-vae.safetensors",
      "directory": "vae",
      "size_gb": 0.3,
      "source_url": "https://huggingface.co/Comfy-Org/vae-text-encorder-for-flux-klein-4b",
      "license": "apache-2.0",
      "access": "open"
    }
  ],
  "graph": {
    "3": {
      "inputs": {
        "unet_name": "flux-2-klein-4b.safetensors",
        "weight_dtype": "default"
      },
      "class_type": "UNETLoader"
    },
    "4": {
      "inputs": {
        "clip_name": "qwen_3_4b.safetensors",
        "type": "flux2",
        "device": "default"
      },
      "class_type": "CLIPLoader"
    },
    "5": {
      "inputs": {
        "vae_name": "flux2-vae.safetensors"
      },
      "class_type": "VAELoader"
    },
    "6": {
      "inputs": {
        "text": "a cat",
        "clip": [
          "4",
          0
        ]
      },
      "class_type": "CLIPTextEncode"
    },
    "7": {
      "inputs": {
        "text": "",
        "clip": [
          "4",
          0
        ]
      },
      "class_type": "CLIPTextEncode"
    },
    "11": {
      "inputs": {
        "width": 512,
        "height": 512,
        "batch_size": 1
      },
      "class_type": "EmptyFlux2LatentImage"
    },
    "12": {
      "inputs": {
        "steps": 1,
        "width": 512,
        "height": 512
      },
      "class_type": "Flux2Scheduler"
    },
    "13": {
      "inputs": {
        "sampler_name": "euler"
      },
      "class_type": "KSamplerSelect"
    },
    "14": {
      "inputs": {
        "noise_seed": 0
      },
      "class_type": "RandomNoise"
    },
    "15": {
      "inputs": {
        "cfg": 3.5,
        "model": [
          "3",
          0
        ],
        "positive": [
          "6",
          0
        ],
        "negative": [
          "7",
          0
        ]
      },
      "class_type": "CFGGuider"
    },
    "16": {
      "inputs": {
        "noise": [
          "14",
          0
        ],
        "guider": [
          "15",
          0
        ],
        "sampler": [
          "13",
          0
        ],
        "sigmas": [
          "12",
          0
        ],
        "latent_image": [
          "11",
          0
        ]
      },
      "class_type": "SamplerCustomAdvanced"
    },
    "17": {
      "inputs": {
        "samples": [
          "16",
          0
        ],
        "vae": [
          "5",
          0
        ]
      },
      "class_type": "VAEDecode"
    },
    "50": {
      "inputs": {
        "upscale_method": "lanczos",
        "width": 512,
        "height": 512,
        "crop": "disabled",
        "image": [
          "17",
          0
        ]
      },
      "class_type": "ImageScale"
    },
    "18": {
      "inputs": {
        "filename_prefix": "ComfyUI",
        "images": [
          "50",
          0
        ]
      },
      "class_type": "SaveImage"
    }
  }
}
