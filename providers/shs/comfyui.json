                  "type": "string"
                },
                "virtual_path": {
                  "type": "string"
                },
                "file_size": {
                  "type": "integer"
                },
                "display_name": {
                  "type": "string"
                }
              }
            }
          },
          "image_count": {
            "type": "integer",
            "description": "Number of images generated"
          },
          "seed_used": {
            "type": "integer",
            "description": "Actual seed used (useful if -1 was specified)"
          },
          "prompt_id": {
            "type": "string",
            "description": "ComfyUI execution ID"
          }
        }
      },
      "output_view": {
        "type": "media_grid",
        "source": "downloaded_files",
        "media_type": "image",
        "thumbnail_field": "virtual_path",
        "download_field": "virtual_path",
        "filename_field": "filename"
      },
      "example_parameters": {
        "prompt": "A majestic mountain landscape at golden hour, with a crystal clear lake reflecting snow-capped peaks",
        "model": "flux1-schnell-q4",
        "styles": [
          "sai-photographic"
        ],
        "steps": 4,
        "batch_size": 1,
        "dimensions": "1920x1080"
      },
