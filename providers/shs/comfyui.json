            "ui": {
              "section": "basic",
              "order": 0.5,
              "widget": "multiselect"
            }
          },
          "style_merge": {
            "type": "string",
            "title": "Style Merge",
            "description": "How to combine multiple style presets",
            "enumNames": [
              "Nested (last style dominant)",
              "Stacked (first style dominant)",
              "Blended (all equal)",
              "Minimal (no style negatives)"
            ],
            "ui": {
              "section": "basic",
              "order": 0.6,
              "inlineWith": "styles",
              "visibleWhen": {
                "field": "styles",
                "condition": "lengthGreaterThan",
                "value": 1
              }
            }
          },
          "prompt": {
            "type": "string",
            "title": "Prompt",
            "description": "Text description of the image to generate",
            "ui": {
              "section": "basic",
              "order": 1,
              "widget": "textarea",
              "rows": 4,
              "placeholder": "a beautiful landscape with mountains and a lake at sunset"
            }
          },
          "negative_prompt": {
            "type": "string",
            "title": "Negative Prompt",
            "description": "What to avoid in the image (optional)",
            "ui": {
              "section": "basic",
              "order": 2,
              "widget": "textarea",
              "rows": 2,
              "placeholder": "blurry, low quality, distorted"
            }
          },
          "seed": {
            "type": "integer",
            "title": "Seed",
            "description": "Random seed for reproducibility (-1 for random)",
            "ui": {
              "section": "advanced",
              "order": 1,
              "placeholder": "-1 for random"
            }
          },
          "steps": {
            "type": "integer",
            "title": "Steps",
            "description": "Number of diffusion steps",
            "ui": {
              "section": "advanced",
              "order": 2
            }
          },
          "batch_size": {
            "type": "integer",
            "title": "Batch Size",
            "description": "Number of images to generate",
            "ui": {
              "section": "advanced",
              "order": 3
            }
          },
          "upscale": {
            "type": "boolean",
            "title": "Fast Mode",
            "description": "Generate a small image then upscale to output dimensions (faster, slightly less detail)",
            "ui": {
              "section": "output",
              "order": 3
            }
          },
          "upscale_method": {
            "type": "string",
            "title": "Method",
            "ui": {
              "section": "output",
              "order": 4,
              "inlineWith": "upscale",
              "hint": "Interpolation algorithm. Lanczos = sharpest, bilinear = smoothest.",
              "visibleWhen": {
                "field": "upscale",
                "condition": "equals",
                "value": true
              }
            }
          },
          "dimensions": {
            "type": "string",
            "title": "Dimensions",
            "description": "Output size; the graph generates aspect-correct and upscales to this.",
            "default": "1920x1080",
            "pattern": "^\\d{2,5}x\\d{2,5}$",
            "ui": {
              "widget": "combobox",
              "suggestions": [
                {
                  "value": "1920x1080",
                  "label": "16:9 - 1920x1080"
                },
                {
                  "value": "1080x1920",
                  "label": "9:16 - 1080x1920"
                },
                {
                  "value": "1024x1024",
                  "label": "1:1 - 1024x1024"
                },
                {
                  "value": "1536x1024",
                  "label": "3:2 - 1536x1024"
                },
                {
                  "value": "1024x1536",
                  "label": "2:3 - 1024x1536"
                },
                {
                  "value": "1344x768",
                  "label": "7:4 - 1344x768"
                },
                {
                  "value": "768x1344",
                  "label": "4:7 - 768x1344"
                }
              ]
            }
          }
        }
      },
      "result_schema": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "description": "Whether generation succeeded"
          },
          "downloaded_files": {
            "type": "array",
            "description": "Generated images",
            "items": {
              "type": "object",
              "properties": {
