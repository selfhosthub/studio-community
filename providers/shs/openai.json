{
  "$schema": "https://raw.githubusercontent.com/selfhosthub/studio-community/main/schemas/provider.schema.json",
  "slug": "shs/openai",
  "version": "1.0.0",
  "name": "OpenAI",
  "description": "AI models for chat completion, embeddings, and image generation",
  "provider_type": "API",
  "category": "ai",
  "status": "ACTIVE",
  "tier": "community",
  "credential_provider": null,
  "requires": [],
  "services_preview": [
    "Chat Completion",
    "Embeddings",
    "Image Generation"
  ],
  "credential_schema": {
    "type": "object",
    "required": [
      "api_key"
    ],
    "properties": {
      "api_key": {
        "type": "string",
        "title": "API Key",
        "description": "OpenAI API key (starts with sk-)",
        "format": "password"
      },
      "organization_id": {
        "type": "string",
        "title": "Organization ID (optional)",
        "description": "OpenAI organization ID for billing attribution"
      }
    }
  },
  "base_url": "https://api.openai.com/v1",
  "icon_url": "/providers/openai.svg",
  "auth": {
    "type": "bearer"
  },
  "services": {
    "openai_chat": {
      "display_name": "Chat Completion",
      "description": "Generate text responses using GPT models. Supports conversation history and system prompts.",
      "service_type": "AI",
      "path": "/chat/completions",
      "method": "POST",
      "requires_credentials": true,
      "prompt_shape": "chat",
      "wire_dialect": "openai",
      "request_transform": {
        "body": {
          "model": "{{ parameters.model }}",
          "messages": "{{ parameters._openai_messages }}",
          "temperature": "{{ parameters.temperature if parameters.temperature is defined and parameters.temperature is not none else '__omit__' }}",
          "max_tokens": "{{ parameters.max_tokens if parameters.max_tokens is defined and parameters.max_tokens is not none else '__omit__' }}",
          "top_p": "{{ parameters.top_p if parameters.top_p is defined and parameters.top_p is not none else '__omit__' }}",
          "frequency_penalty": "{{ parameters.frequency_penalty if parameters.frequency_penalty is defined and parameters.frequency_penalty is not none else '__omit__' }}",
          "presence_penalty": "{{ parameters.presence_penalty if parameters.presence_penalty is defined and parameters.presence_penalty is not none else '__omit__' }}",
          "stop": "{{ parameters.stop if parameters.stop is defined and parameters.stop is not none else '__omit__' }}",
          "seed": "{{ parameters.seed if parameters.seed is defined and parameters.seed is not none else '__omit__' }}",
          "response_format": "{{ parameters.response_format if parameters.response_format is defined and parameters.response_format is not none else '__omit__' }}",
          "user": "{{ parameters.user if parameters.user is defined and parameters.user is not none else '__omit__' }}"
        }
      },
      "parameter_schema": {
        "type": "object",
        "required": [
          "model",
          "messages"
        ],
        "properties": {
          "model": {
            "type": "string",
            "title": "Model",
            "description": "The model to use for completion",
            "enum": [
              "gpt-5.5",
              "gpt-5.4",
              "gpt-5.4-mini",
              "gpt-5.4-nano",
              "gpt-4.1",
              "gpt-4.1-mini",
              "gpt-4o-mini"
            ],
            "enumNames": [
              "GPT-5.5 (Flagship)",
              "GPT-5.4 (Affordable Frontier)",
              "GPT-5.4 Mini (Fast & Cheap)",
              "GPT-5.4 Nano (Cheapest)",
              "GPT-4.1 (Non-Reasoning)",
              "GPT-4.1 Mini (Fast Non-Reasoning)",
              "GPT-4o Mini (Legacy)"
            ],
            "default": "gpt-5.5",
            "ui": {
              "section": "basic",
              "order": 1
            }
          },
          "messages": {
            "type": "array",
            "title": "Messages",
            "description": "The conversation messages. Each message has a role (system, user, assistant) and content.",
            "items": {
              "type": "object",
              "required": [
                "role",
                "content"
              ],
              "properties": {
                "role": {
                  "type": "string",
                  "title": "Role",
                  "enum": [
                    "system",
                    "user",
                    "assistant"
                  ],
                  "default": "user"
                },
                "content": {
                  "type": "string",
                  "title": "Content",
                  "description": "The message content",
                  "ui": {
                    "widget": "textarea"
                  }
                }
              }
            },
            "minItems": 1,
            "ui": {
              "section": "basic",
              "order": 2,
              "prompt": true
            }
          },
          "temperature": {
            "type": "number",
            "title": "Temperature",
            "description": "Controls randomness. 0 = deterministic, 2 = very random.",
            "default": 1,
            "minimum": 0,
            "maximum": 2,
            "ui": {
              "section": "basic",
              "order": 3
            }
          },
          "max_tokens": {
            "type": "integer",
            "title": "Max Tokens",
            "description": "Maximum tokens in the response. Leave empty for model default.",
            "minimum": 1,
            "maximum": 128000,
            "ui": {
              "section": "basic",
              "order": 4
            }
          },
          "top_p": {
            "type": "number",
            "title": "Top P",
            "description": "Nucleus sampling. Consider tokens with top_p probability mass.",
            "default": 1,
            "minimum": 0,
            "maximum": 1,
            "ui": {
              "section": "advanced",
              "order": 1
            }
          },
          "frequency_penalty": {
            "type": "number",
            "title": "Frequency Penalty",
            "description": "Penalize tokens based on frequency in text so far. -2 to 2.",
            "default": 0,
            "minimum": -2,
            "maximum": 2,
            "ui": {
              "section": "advanced",
              "order": 2
            }
          },
          "presence_penalty": {
            "type": "number",
            "title": "Presence Penalty",
            "description": "Penalize tokens based on presence in text so far. -2 to 2.",
            "default": 0,
            "minimum": -2,
            "maximum": 2,
            "ui": {
              "section": "advanced",
              "order": 3
            }
          },
          "stop": {
            "type": "array",
            "title": "Stop Sequences",
            "description": "Up to 4 sequences where the API will stop generating.",
            "items": {
              "type": "string"
            },
            "maxItems": 4,
            "ui": {
              "section": "advanced",
              "order": 4,
              "widget": "tags"
            }
          },
          "seed": {
            "type": "integer",
            "title": "Seed",
            "description": "For deterministic sampling. Same seed = same output (beta).",
            "ui": {
              "section": "advanced",
              "order": 5
            }
          },
          "response_format": {
            "type": "object",
            "title": "Response Format",
            "description": "Force JSON output format",
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "text",
                  "json_object"
                ],
                "default": "text"
              }
            },
            "ui": {
              "section": "advanced",
              "order": 6
            }
          },
          "user": {
            "type": "string",
            "title": "User ID",
            "description": "Unique identifier for end-user tracking and abuse monitoring.",
            "ui": {
              "section": "advanced",
              "order": 7
            }
          }
        }
      },
      "result_schema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Unique completion ID"
          },
          "object": {
            "type": "string"
          },
          "created": {
            "type": "integer",
            "description": "Unix timestamp"
          },
          "model": {
            "type": "string",
            "description": "Model used"
          },
          "choices": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "index": {
                  "type": "integer"
                },
                "message": {
                  "type": "object",
                  "properties": {
                    "role": {
                      "type": "string"
                    },
                    "content": {
                      "type": "string"
                    }
                  }
                },
                "finish_reason": {
                  "type": "string"
                }
              }
            }
          },
          "usage": {
            "type": "object",
            "properties": {
              "prompt_tokens": {
                "type": "integer"
              },
              "completion_tokens": {
                "type": "integer"
              },
              "total_tokens": {
                "type": "integer"
              },
              "prompt_tokens_details": {
                "type": "object",
                "description": "Prompt-side token breakdown (cached/uncached). Returned when the request hit the prompt cache.",
                "properties": {
                  "cached_tokens": {
                    "type": "integer"
                  },
                  "audio_tokens": {
                    "type": "integer"
                  }
                }
              },
              "completion_tokens_details": {
                "type": "object",
                "description": "Completion-side token breakdown. Returned for reasoning models (o1/o3-class); `reasoning_tokens` is load-bearing for cost attribution.",
                "properties": {
                  "reasoning_tokens": {
                    "type": "integer"
                  },
                  "audio_tokens": {
                    "type": "integer"
                  },
                  "accepted_prediction_tokens": {
                    "type": "integer"
                  },
                  "rejected_prediction_tokens": {
                    "type": "integer"
                  }
                }
              }
            }
          },
          "service_tier": {
            "type": "string",
            "description": "Tier the request was routed through (e.g. `default`, `scale`, `flex`). Echoed back when the request specified a tier."
          },
          "system_fingerprint": {
            "type": "string",
            "description": "Backend fingerprint identifying the model snapshot serving the request. Used for reproducibility / cache-key construction."
          }
        }
      },
      "output_view": {
        "type": "key_value",
        "fields": [
          {
            "key": "choices.0.message.content",
            "label": "Response"
          },
          {
            "key": "choices.0.message.role",
            "label": "Role"
          },
          {
            "key": "model",
            "label": "Model"
          },
          {
            "key": "choices.0.finish_reason",
            "label": "Finish Reason"
          },
          {
            "key": "usage.total_tokens",
            "label": "Total Tokens"
          }
        ]
      },
      "example_parameters": {
        "model": "gpt-5.5",
        "messages": [
          {
            "role": "system",
            "content": "You are a helpful assistant."
          },
          {
            "role": "user",
            "content": "What is the capital of France?"
          }
        ],
        "temperature": 0.7,
        "max_tokens": 1000
      },
      "ui_hints": {
        "color": "#10a37f",
        "icon": "message-square",
        "sections": {
          "basic": {
            "title": "Basic",
            "collapsed": false,
            "order": 1
          },
          "advanced": {
            "title": "Advanced Options",
            "collapsed": true,
            "order": 2
          }
        },
        "categories": [
          "ai"
        ]
      }
    },
    "openai_embeddings": {
      "display_name": "Embeddings",
      "description": "Generate vector embeddings for text. Use for semantic search, clustering, and similarity comparisons.",
      "service_type": "AI",
      "path": "/embeddings",
      "method": "POST",
      "requires_credentials": true,
      "parameter_mapping": {
        "body": [
          "model",
          "input",
          "dimensions",
          "encoding_format",
          "user"
        ]
      },
      "parameter_schema": {
        "type": "object",
        "required": [
          "model",
          "input"
        ],
        "properties": {
          "model": {
            "type": "string",
            "title": "Model",
            "description": "The embedding model to use",
            "enum": [
              "text-embedding-3-small",
              "text-embedding-3-large",
              "text-embedding-ada-002"
            ],
            "enumNames": [
              "text-embedding-3-small (Recommended)",
              "text-embedding-3-large (Higher quality)",
              "text-embedding-ada-002 (Legacy)"
            ],
            "default": "text-embedding-3-small",
            "ui": {
              "order": 1
            }
          },
          "input": {
            "type": "string",
            "title": "Input Text",
            "description": "The text to generate embeddings for",
            "ui": {
              "order": 2,
              "widget": "textarea",
              "rows": 4
            }
          },
          "dimensions": {
            "type": "integer",
            "title": "Dimensions",
            "description": "Output vector dimensions (only for text-embedding-3 models). Smaller = faster search, larger = more accurate.",
            "minimum": 1,
            "maximum": 3072,
            "ui": {
              "order": 3,
              "show_when": {
                "model": [
                  "text-embedding-3-small",
                  "text-embedding-3-large"
                ]
              }
            }
          },
          "encoding_format": {
            "type": "string",
            "title": "Encoding Format",
            "description": "Output format for embeddings",
            "enum": [
              "float",
              "base64"
            ],
            "default": "float",
            "ui": {
              "order": 4
            }
          },
          "user": {
            "type": "string",
            "title": "User ID",
            "description": "Unique identifier for end-user tracking",
            "ui": {
              "order": 5
            }
          }
        }
      },
      "result_schema": {
        "type": "object",
        "properties": {
          "object": {
            "type": "string"
          },
          "data": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "object": {
                  "type": "string"
                },
                "index": {
                  "type": "integer"
                },
                "embedding": {
                  "type": "array",
                  "items": {
                    "type": "number"
                  }
                }
              }
            }
          },
          "model": {
            "type": "string"
          },
          "usage": {
            "type": "object",
            "properties": {
              "prompt_tokens": {
                "type": "integer"
              },
              "total_tokens": {
                "type": "integer"
              }
            }
          }
        }
      },
      "output_view": {
        "type": "key_value",
        "fields": [
          {
            "key": "model",
            "label": "Model"
          },
          {
            "key": "data.0.index",
            "label": "Index"
          },
          {
            "key": "usage.prompt_tokens",
            "label": "Prompt Tokens"
          },
          {
            "key": "usage.total_tokens",
            "label": "Total Tokens"
          }
        ]
      },
      "example_parameters": {
        "model": "text-embedding-3-small",
        "input": "The quick brown fox jumps over the lazy dog."
      },
      "ui_hints": {
        "color": "#10a37f",
        "icon": "hash",
        "categories": [
          "ai"
        ]
      }
    },
    "openai_images": {
      "display_name": "Image Generation",
      "description": "Generate images using DALL-E models. Create original images from text descriptions.",
      "service_type": "AI",
      "path": "/images/generations",
      "method": "POST",
      "requires_credentials": true,
      "request_transform": {
        "body": {
          "prompt": "{{ parameters.prompt }}",
          "model": "{{ parameters.model }}",
          "size": "{{ parameters.size if parameters.size is defined and parameters.size is not none else '__omit__' }}",
          "quality": "{{ parameters.quality if parameters.quality is defined and parameters.quality is not none else '__omit__' }}",
          "style": "{{ parameters.style if parameters.model == 'dall-e-3' and parameters.style is defined and parameters.style is not none else '__omit__' }}",
          "n": "{{ parameters.n if parameters.n is defined and parameters.n is not none else '__omit__' }}",
          "response_format": "{{ 'b64_json' if parameters.model == 'dall-e-3' else '__omit__' }}",
          "user": "{{ parameters.user if parameters.user is defined and parameters.user is not none else '__omit__' }}"
        }
      },
      "parameter_schema": {
        "type": "object",
        "required": [
          "prompt"
        ],
        "properties": {
          "prompt": {
            "type": "string",
            "title": "Prompt",
            "description": "A text description of the desired image. Maximum 4000 characters for DALL-E 3.",
            "maxLength": 4000,
            "ui": {
              "section": "basic",
              "order": 1,
              "widget": "textarea",
              "rows": 4
            }
          },
          "model": {
            "type": "string",
            "title": "Model",
            "description": "The image generation model to use",
            "enum": [
              "gpt-image-2",
              "dall-e-3"
            ],
            "enumNames": [
              "GPT Image 2 (Recommended)",
              "DALL-E 3 (Legacy)"
            ],
            "default": "gpt-image-2",
            "ui": {
              "section": "basic",
              "order": 2
            }
          },
          "size": {
            "type": "string",
            "title": "Size",
            "description": "Image dimensions. GPT Image 2 supports 1024x1024, 1536x1024, 1024x1536. DALL-E 3 supports 1024x1024, 1792x1024, 1024x1792.",
            "enum": [
              "1024x1024",
              "1536x1024",
              "1024x1536",
              "1792x1024",
              "1024x1792"
            ],
            "enumNames": [
              "1024x1024 (Square)",
              "1536x1024 (Landscape, GPT Image 2)",
              "1024x1536 (Portrait, GPT Image 2)",
              "1792x1024 (Landscape, DALL-E 3)",
              "1024x1792 (Portrait, DALL-E 3)"
            ],
            "default": "1024x1024",
            "ui": {
              "section": "basic",
              "order": 3
            }
          },
          "quality": {
            "type": "string",
            "title": "Quality",
            "description": "Image quality.",
            "enum": [
              "auto",
              "low",
              "medium",
              "high",
              "standard",
              "hd"
            ],
            "enumNames": [
              "Auto (GPT Image 2)",
              "Low (GPT Image 2)",
              "Medium (GPT Image 2)",
              "High (GPT Image 2)",
              "Standard (DALL-E 3)",
              "HD (DALL-E 3)"
            ],
            "default": "auto",
            "ui": {
              "section": "basic",
              "order": 4
            }
          },
          "style": {
            "type": "string",
            "title": "Style",
            "description": "Visual style of the generated image",
            "enum": [
              "vivid",
              "natural"
            ],
            "enumNames": [
              "Vivid (Hyper-real & dramatic)",
              "Natural (More natural, less hyper-real)"
            ],
            "default": "vivid",
            "ui": {
              "section": "basic",
              "order": 5,
              "show_when": {
                "model": "dall-e-3"
              }
            }
          },
          "n": {
            "type": "integer",
            "title": "Number of Images",
            "description": "Number of images to generate. DALL-E 3 only supports 1.",
            "default": 1,
            "minimum": 1,
            "maximum": 10,
            "ui": {
              "section": "basic",
              "order": 6,
              "show_when": {
                "model": "gpt-image-2"
              }
            }
          },
          "user": {
            "type": "string",
            "title": "User ID",
            "description": "Unique identifier for end-user tracking",
            "ui": {
              "section": "advanced",
              "order": 2
            }
          }
        }
      },
      "post_processing": {
        "decode_base64": {
          "source_path": "$.data[*].b64_json",
          "filename_pattern": "openai_image_{index}.png",
          "max_file_size_mb": 50
        }
      },
      "result_schema": {
        "type": "object",
        "properties": {
          "created": {
            "type": "integer",
            "description": "Unix timestamp"
          },
          "data": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "url": {
                  "type": "string",
                  "description": "URL to download the image (expires after 1 hour)"
                },
                "b64_json": {
                  "type": "string",
                  "description": "Base64-encoded image data"
                },
                "revised_prompt": {
                  "type": "string",
                  "description": "The prompt that was used (DALL-E 3 may revise prompts)"
                }
              }
            }
          },
          "downloaded_files": {
            "type": "array",
            "description": "Downloaded image files (added by post-processing)",
            "items": {
              "type": "object",
              "properties": {
                "filename": {
                  "type": "string"
                },
                "file_size": {
                  "type": "integer"
                },
                "virtual_path": {
                  "type": "string"
                }
              }
            }
          }
        }
      },
      "output_view": {
        "type": "media_grid",
        "source": "downloaded_files",
        "media_type": "image",
        "thumbnail_field": "virtual_path",
        "download_field": "virtual_path",
        "filename_field": "filename"
      },
      "example_parameters": {
        "prompt": "A white siamese cat sitting on a windowsill at sunset, digital art",
        "model": "gpt-image-2",
        "size": "1024x1024",
        "quality": "auto"
      },
      "ui_hints": {
        "color": "#10a37f",
        "icon": "image",
        "sections": {
          "basic": {
            "title": "Basic",
            "collapsed": false,
            "order": 1
          },
          "advanced": {
            "title": "Advanced",
            "collapsed": true,
            "order": 2
          }
        },
        "categories": [
          "ai"
        ]
      }
    },
    "openai_tts": {
      "display_name": "Text to Speech",
      "description": "Generate natural-sounding speech from text using OpenAI TTS models. Supports multiple voices and languages.",
      "service_type": "AI",
      "path": "/audio/speech",
      "method": "POST",
      "requires_credentials": true,
      "response_type": "binary",
      "parameter_mapping": {
        "body": [
          "model",
          "input",
          "voice",
          "response_format",
          "speed"
        ]
      },
      "parameter_schema": {
        "type": "object",
        "required": [
          "input"
        ],
        "properties": {
          "input": {
            "type": "string",
            "title": "Text",
            "description": "The text to generate audio for. Maximum 4096 characters.",
            "maxLength": 4096,
            "ui": {
              "section": "basic",
              "order": 1,
              "widget": "textarea",
              "rows": 4
            }
          },
          "model": {
            "type": "string",
            "title": "Model",
            "description": "The TTS model to use",
            "enum": [
              "tts-1",
              "tts-1-hd"
            ],
            "enumNames": [
              "TTS-1 (Fast)",
              "TTS-1 HD (Higher quality)"
            ],
            "default": "tts-1",
            "ui": {
              "section": "basic",
              "order": 2
            }
          },
          "voice": {
            "type": "string",
            "title": "Voice",
            "description": "The voice to use for speech generation",
            "enum": [
              "cedar",
              "marin",
              "alloy",
              "ash",
              "ballad",
              "coral",
              "echo",
              "fable",
              "nova",
              "onyx",
              "sage",
              "shimmer",
              "verse"
            ],
            "enumNames": [
              "Cedar (Warm, conversational)",
              "Marin (Bright, articulate)",
              "Alloy (Balanced, versatile)",
              "Ash (Clear, direct)",
              "Ballad (Soft, melodic)",
              "Coral (Warm, friendly)",
              "Echo (Smooth, neutral)",
              "Fable (Expressive, storytelling)",
              "Nova (Bright, energetic)",
              "Onyx (Deep, authoritative)",
              "Sage (Calm, measured)",
              "Shimmer (Light, cheerful)",
              "Verse (Rich, dramatic)"
            ],
            "default": "cedar",
            "ui": {
              "section": "basic",
              "order": 3
            }
          },
          "language": {
            "type": "string",
            "title": "Language",
            "description": "Target language. The model auto-detects from input text, but this helps ensure correct pronunciation and is used by downstream steps (e.g., subtitles).",
            "enum": [
              "en",
              "es",
              "fr",
