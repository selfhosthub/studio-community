              "state": {
                "type": "string"
              },
              "postal_code": {
                "type": "string"
              },
              "country": {
                "type": "string"
              }
            },
            "x-ui-hints": {
              "format": "json-editor"
            },
            "ui": {
              "section": "Advanced",
              "order": 3,
              "collapsed": true
            }
          },
          "payment_method": {
            "type": "string",
            "title": "Payment Method",
            "description": "ID of payment method to attach to customer",
            "ui": {
              "section": "Advanced",
              "order": 4,
              "collapsed": true
            }
          },
          "invoice_settings": {
            "type": "object",
            "title": "Invoice Settings",
            "description": "Default invoice settings for this customer",
            "x-ui-hints": {
              "format": "json-editor"
            },
            "ui": {
              "section": "Advanced",
              "order": 5,
              "collapsed": true
            }
          }
        }
      },
      "result_schema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Unique identifier for the customer"
          },
          "object": {
            "type": "string",
            "enum": [
              "customer"
            ]
          },
          "email": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "created": {
            "type": "integer",
            "description": "Time created (Unix timestamp)"
          },
          "metadata": {
            "type": "object"
          }
        }
      },
      "output_view": {
        "type": "key_value",
        "fields": [
          {
            "key": "id",
            "label": "Customer ID"
          },
          {
            "key": "email",
            "label": "Email"
          },
          {
            "key": "name",
            "label": "Name"
          },
          {
            "key": "created",
            "label": "Created"
          }
        ]
      },
      "example_parameters": {
        "secret_key": "sk_test_abc123",
        "email": "jane@example.com",
        "name": "Jane Doe"
      },
      "ui_hints": {
        "categories": [
          "productivity"
        ]
      }
    },
