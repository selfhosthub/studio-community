          },
          "email": {
            "type": "string",
            "title": "Email",
            "description": "Customer's email address",
            "format": "email",
            "ui": {
              "section": "Main",
              "order": 2
            }
          },
          "name": {
            "type": "string",
            "title": "Name",
            "description": "Customer's full name",
            "ui": {
              "section": "Main",
              "order": 3
            }
          },
          "description": {
            "type": "string",
            "title": "Description",
            "description": "Arbitrary description for internal use",
            "ui": {
              "section": "Main",
              "order": 4
            }
          },
          "phone": {
            "type": "string",
            "title": "Phone",
            "description": "Customer's phone number",
            "ui": {
