    "stripe_create_payment_intent": {
      "display_name": "Create Payment Intent",
      "description": "Create a payment intent to collect payment from a customer. Supports one-time and recurring payments.",
      "service_type": "PRODUCTIVITY",
      "endpoint_url": "https://api.stripe.com/v1",
      "path": "/payment_intents",
      "method": "POST",
      "requires_credentials": true,
      "parameter_mapping": {
        "header": [
          "secret_key"
        ],
        "body": [
          "amount",
          "currency",
          "customer",
          "description",
          "metadata",
          "payment_method",
          "confirm",
          "return_url",
          "automatic_payment_methods"
        ]
      },
      "parameter_schema": {
        "type": "object",
        "required": [
          "secret_key",
          "amount",
          "currency"
        ],
        "properties": {
          "secret_key": {
            "type": "string",
            "title": "Secret Key",
            "description": "Your Stripe secret API key",
            "x-ui-hints": {
              "format": "credential_field"
            },
            "ui": {
              "section": "Main",
              "order": 1
            }
          },
          "amount": {
            "type": "integer",
            "title": "Amount",
            "description": "Amount in cents (e.g., 2000 = $20.00)",
            "minimum": 0,
            "examples": [
              2000,
              5000,
              10000
            ],
            "ui": {
              "section": "Main",
              "order": 2
            }
          },
          "currency": {
            "type": "string",
            "title": "Currency",
            "description": "Three-letter ISO currency code (lowercase)",
            "enum": [
              "usd",
              "eur",
              "gbp",
              "cad",
              "aud",
              "jpy"
            ],
            "default": "usd",
            "x-ui-hints": {
              "format": "select"
            },
            "ui": {
              "section": "Main",
              "order": 3
            }
          },
          "customer": {
            "type": "string",
            "title": "Customer ID",
            "description": "ID of the customer for this payment",
            "examples": [
              "cus_ABC123"
            ],
            "ui": {
              "section": "Main",
              "order": 4
            }
          },
          "description": {
            "type": "string",
            "title": "Description",
            "description": "Arbitrary description for this payment intent",
            "ui": {
              "section": "Main",
              "order": 5
            }
          },
          "metadata": {
            "type": "object",
            "title": "Metadata",
            "description": "Set of key-value pairs for custom data",
            "x-ui-hints": {
              "format": "json-editor"
            },
            "ui": {
              "section": "Advanced",
              "order": 1,
              "collapsed": true
            }
          },
          "payment_method": {
            "type": "string",
            "title": "Payment Method ID",
            "description": "ID of payment method to use (if pre-saved)",
            "ui": {
              "section": "Advanced",
              "order": 2,
              "collapsed": true
            }
          },
          "confirm": {
            "type": "boolean",
            "title": "Confirm Immediately",
            "description": "Set to true to attempt to confirm this PaymentIntent immediately",
            "default": false,
            "ui": {
              "section": "Advanced",
              "order": 3,
              "collapsed": true
            }
          },
          "return_url": {
            "type": "string",
            "title": "Return URL",
            "description": "URL to redirect customer after completing authentication",
            "ui": {
              "section": "Advanced",
              "order": 4,
              "collapsed": true
            }
          },
          "automatic_payment_methods": {
            "type": "object",
            "title": "Automatic Payment Methods",
            "description": "Enable automatic payment method collection (e.g., {\"enabled\": true})",
            "x-ui-hints": {
              "format": "json-editor"
            },
            "ui": {
              "section": "Advanced",
              "order": 5,
              "collapsed": true
            }
          }
        }
      },
      "result_schema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Payment Intent ID"
          },
          "object": {
            "type": "string",
            "enum": [
              "payment_intent"
            ]
          },
          "amount": {
            "type": "integer"
          },
          "currency": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "client_secret": {
            "type": "string",
            "description": "Secret for client-side confirmation"
          },
          "customer": {
            "type": "string"
          },
          "created": {
            "type": "integer"
          }
        }
      },
      "output_view": {
        "type": "key_value",
        "fields": [
          {
            "key": "id",
            "label": "Payment Intent ID"
          },
          {
            "key": "amount",
            "label": "Amount (cents)"
          },
          {
            "key": "currency",
            "label": "Currency"
          },
          {
            "key": "status",
            "label": "Status"
          },
          {
            "key": "client_secret",
            "label": "Client Secret"
          }
        ]
      },
