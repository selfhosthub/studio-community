{
  "$schema": "https://raw.githubusercontent.com/selfhosthub/studio-community/main/schemas/provider.schema.json",
  "slug": "shs/stripe",
  "version": "1.0.0",
  "name": "Stripe",
  "description": "Payment processing with customers, charges, and subscriptions",
  "provider_type": "API",
  "category": "productivity",
  "status": "ACTIVE",
  "tier": "community",
  "credential_provider": null,
  "requires": [],
  "services_preview": [
    "List Customers",
    "Create Customer",
    "Create Charge",
    "List Subscriptions"
  ],
  "credential_schema": {
    "type": "object",
    "required": [
      "secret_key"
    ],
    "properties": {
      "secret_key": {
        "type": "string",
        "title": "Secret Key",
        "description": "Stripe secret key (starts with sk_)",
        "format": "password"
      }
    }
  },
  "base_url": "https://api.stripe.com/v1",
  "auth": {
    "type": "bearer",
    "config": {
      "token_field": "secret_key"
    }
  },
  "default_headers": {
    "Content-Type": "application/x-www-form-urlencoded"
  },
  "form_array_style": "brackets",
  "services": {
    "stripe_list_customers": {
      "display_name": "List Customers",
      "description": "Retrieve a list of customers. Supports filtering, pagination, and searching by email.",
      "service_type": "PRODUCTIVITY",
      "endpoint_url": "https://api.stripe.com/v1",
      "path": "/customers",
      "method": "GET",
      "requires_credentials": true,
      "parameter_mapping": {
        "header": [
          "secret_key"
        ],
        "query": [
          "email",
          "limit",
          "starting_after",
          "ending_before",
          "created"
        ]
      },
      "parameter_schema": {
        "type": "object",
        "required": [
          "secret_key"
        ],
        "properties": {
          "secret_key": {
            "type": "string",
            "title": "Secret Key",
            "description": "Your Stripe secret API key (starts with sk_)",
            "x-ui-hints": {
              "format": "credential_field"
            },
            "ui": {
              "section": "Main",
              "order": 1
            }
          },
          "email": {
            "type": "string",
            "title": "Email Filter",
            "description": "Filter customers by email address",
            "format": "email",
            "ui": {
              "section": "Main",
              "order": 2
            }
          },
          "limit": {
            "type": "integer",
            "title": "Limit",
            "description": "Number of customers to return (1-100)",
            "minimum": 1,
            "maximum": 100,
            "default": 10,
            "ui": {
              "section": "Main",
              "order": 3
            }
          },
          "starting_after": {
            "type": "string",
            "title": "Starting After",
            "description": "Cursor for pagination - customer ID to start after",
            "ui": {
              "section": "Advanced",
              "order": 1,
              "collapsed": true
            }
          },
          "ending_before": {
            "type": "string",
            "title": "Ending Before",
            "description": "Cursor for pagination - customer ID to end before",
            "ui": {
              "section": "Advanced",
              "order": 2,
              "collapsed": true
            }
          },
          "created": {
            "type": "object",
            "title": "Created Filter",
            "description": "Filter by creation date (e.g., {\"gte\": 1609459200} for after Jan 1, 2021)",
            "x-ui-hints": {
              "format": "json-editor"
            },
            "ui": {
              "section": "Advanced",
              "order": 3,
              "collapsed": true
            }
          }
        }
      },
      "result_schema": {
        "type": "object",
        "properties": {
          "object": {
            "type": "string",
            "enum": [
              "list"
            ]
          },
          "data": {
            "type": "array",
            "description": "Array of Customer objects",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "description": "Customer ID"
                },
                "email": {
                  "type": "string",
                  "description": "Customer email"
                },
                "name": {
                  "type": "string",
                  "description": "Customer name"
                },
                "created": {
                  "type": "integer",
                  "description": "Time created (Unix timestamp)"
                }
              }
            }
          },
          "has_more": {
            "type": "boolean",
            "description": "Whether there are more results"
          },
          "url": {
            "type": "string",
            "description": "The URL for accessing this list"
          }
        }
      },
      "output_view": {
        "type": "table",
        "source": "data",
        "columns": [
          {
            "key": "id",
            "label": "Customer ID"
          },
          {
            "key": "email",
            "label": "Email"
          },
          {
            "key": "name",
            "label": "Name"
          },
          {
            "key": "created",
            "label": "Created"
          }
        ]
      },
      "example_parameters": {
        "secret_key": "sk_test_abc123",
        "limit": 10
      },
      "ui_hints": {
        "categories": [
          "productivity"
        ]
      }
    },
    "stripe_create_customer": {
      "display_name": "Create Customer",
      "description": "Create a new customer in Stripe. Store email, name, payment methods, and metadata for future charges.",
      "service_type": "PRODUCTIVITY",
