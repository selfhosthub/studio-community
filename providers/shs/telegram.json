      "result_schema": {
        "type": "object",
        "properties": {
          "ok": {
            "type": "boolean",
            "description": "True if the request was successful"
          },
          "result": {
            "type": "object",
            "properties": {
              "message_id": {
                "type": "integer",
                "description": "Unique message identifier"
              },
              "chat": {
                "type": "object",
                "description": "Chat information"
              },
              "date": {
                "type": "integer",
