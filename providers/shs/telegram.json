    "telegram_get_updates": {
      "display_name": "Get Updates",
      "description": "Receive incoming updates (messages, commands, callbacks) using long polling. Use for polling-based workflows instead of webhooks.",
      "service_type": "COMMUNICATION",
      "endpoint_url": "https://api.telegram.org/bot{bot_token}",
      "path": "/getUpdates",
      "method": "POST",
      "requires_credentials": true,
      "parameter_mapping": {
        "path": [
          "bot_token"
        ],
        "body": [
          "offset",
          "limit",
          "timeout",
          "allowed_updates"
        ]
      },
      "parameter_schema": {
        "type": "object",
        "required": [
          "bot_token"
        ],
        "properties": {
          "bot_token": {
            "type": "string",
            "title": "Bot Token",
            "description": "Your Telegram bot token from @BotFather",
            "ui": {
              "section": "Main",
              "order": 1
            },
            "x-ui-hints": {
              "format": "credential_field"
            }
          },
          "offset": {
            "type": "integer",
            "title": "Offset",
            "description": "Identifier of the first update to be returned. Updates with IDs less than this will be ignored.",
            "default": 0,
            "ui": {
              "section": "Advanced",
              "order": 1
            }
          },
          "limit": {
            "type": "integer",
            "title": "Limit",
            "description": "Limits the number of updates to be retrieved. Values between 1-100 are accepted.",
            "minimum": 1,
            "maximum": 100,
            "default": 100,
            "ui": {
              "section": "Main",
              "order": 2
            }
          },
          "timeout": {
            "type": "integer",
            "title": "Timeout",
            "description": "Timeout in seconds for long polling. Should be positive, short polling is used by default (0).",
            "minimum": 0,
            "default": 0,
            "ui": {
              "section": "Advanced",
              "order": 2
            }
          },
          "allowed_updates": {
            "type": "array",
            "title": "Allowed Updates",
            "description": "List of update types you want to receive. Leave empty to receive all update types.",
            "items": {
              "type": "string",
              "enum": [
                "message",
                "edited_message",
                "channel_post",
                "edited_channel_post",
                "inline_query",
                "chosen_inline_result",
                "callback_query",
                "shipping_query",
                "pre_checkout_query",
                "poll",
                "poll_answer",
                "my_chat_member",
                "chat_member",
                "chat_join_request"
              ]
            },
            "ui": {
              "section": "Advanced",
              "order": 3
            },
            "x-ui-hints": {
              "format": "multi-select"
            }
          }
        }
      },
      "result_schema": {
        "type": "object",
        "properties": {
          "ok": {
            "type": "boolean"
          },
          "result": {
            "type": "array",
            "description": "Array of Update objects",
            "items": {
              "type": "object",
              "properties": {
                "update_id": {
                  "type": "integer"
                },
                "message": {
                  "type": "object",
                  "description": "New incoming message"
                },
                "callback_query": {
                  "type": "object",
                  "description": "New incoming callback query"
                }
              }
            }
          }
        }
      },
      "output_view": {
        "type": "key_value",
        "fields": [
          {
            "key": "ok",
            "label": "Success"
          },
          {
            "key": "result.length",
            "label": "Updates Count"
          }
        ]
      },
      "example_parameters": {
        "bot_token": "123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11",
        "limit": 10,
        "timeout": 0
      },
      "ui_hints": {
        "sections": {
          "Main": {
            "title": "Main",
            "collapsed": false,
            "order": 1
          },
          "Advanced": {
            "title": "Advanced",
            "collapsed": true,
            "order": 2
          }
        },
        "categories": [
          "communication"
        ]
      }
    },
    "telegram_send_location": {
      "display_name": "Send Location",
      "description": "Send a geographic location (latitude and longitude) to a Telegram chat or channel.",
      "service_type": "COMMUNICATION",
      "endpoint_url": "https://api.telegram.org/bot{bot_token}",
      "path": "/sendLocation",
      "method": "POST",
      "requires_credentials": true,
      "parameter_mapping": {
        "path": [
          "bot_token"
        ],
        "body": [
          "chat_id",
          "latitude",
          "longitude",
          "horizontal_accuracy",
          "live_period",
          "heading",
          "proximity_alert_radius",
