      "service_type": "COMMUNICATION",
      "endpoint_url": "https://api.telegram.org/bot{bot_token}",
      "path": "/sendDocument",
      "method": "POST",
      "requires_credentials": true,
      "parameter_mapping": {
        "path": [
          "bot_token"
        ],
        "body": [
          "chat_id",
          "document",
          "caption",
          "parse_mode",
          "disable_content_type_detection",
          "disable_notification",
          "protect_content",
