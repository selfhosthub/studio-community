{
  "$schema": "https://raw.githubusercontent.com/selfhosthub/studio-community/main/schemas/provider.schema.json",
  "slug": "shs/telegram",
  "version": "1.0.0",
  "name": "Telegram",
  "description": "Messaging and bot automation for Telegram",
  "provider_type": "API",
  "category": "communication",
  "status": "ACTIVE",
  "tier": "community",
  "credential_provider": null,
  "requires": [],
  "services_preview": [
    "Send Message",
    "Send Photo",
    "Get Updates",
    "Get Chat"
  ],
  "credential_schema": {
    "type": "object",
    "required": [
      "bot_token"
    ],
    "properties": {
      "bot_token": {
        "type": "string",
        "title": "Bot Token",
        "description": "Telegram bot token from @BotFather",
        "format": "password"
      }
    }
  },
  "base_url": "https://api.telegram.org",
  "auth": {
    "type": "custom",
    "config": {
      "token_location": "path"
    }
  },
  "default_headers": {
    "Content-Type": "application/json"
  },
  "services": {
    "telegram_send_message": {
      "display_name": "Send Message",
      "description": "Send a text message to a Telegram chat or channel. Supports Markdown and HTML formatting, reply markup, and threading.",
      "service_type": "COMMUNICATION",
      "endpoint_url": "https://api.telegram.org/bot{bot_token}",
      "path": "/sendMessage",
      "method": "POST",
      "requires_credentials": true,
      "parameter_mapping": {
        "path": [
          "bot_token"
        ],
        "body": [
          "chat_id",
          "text",
          "parse_mode",
          "entities",
          "disable_web_page_preview",
          "disable_notification",
          "protect_content",
          "reply_to_message_id",
          "allow_sending_without_reply",
          "reply_markup"
        ]
      },
      "parameter_schema": {
        "type": "object",
        "required": [
          "bot_token",
          "chat_id",
          "text"
        ],
        "properties": {
          "bot_token": {
            "type": "string",
            "title": "Bot Token",
            "description": "Your Telegram bot token from @BotFather",
            "ui": {
              "section": "Main",
              "order": 1
            },
            "x-ui-hints": {
              "format": "credential_field"
            }
          },
          "chat_id": {
            "type": [
              "string",
              "integer"
            ],
            "title": "Chat ID",
            "description": "Unique identifier for the target chat or username of the target channel (e.g., @channelusername)",
            "examples": [
              "123456789",
              "@mychannel"
            ],
            "ui": {
              "section": "Main",
              "order": 2
            }
          },
          "text": {
            "type": "string",
            "title": "Message Text",
            "description": "Text of the message to be sent, 1-4096 characters",
            "maxLength": 4096,
            "ui": {
              "section": "Main",
              "order": 3
            },
            "x-ui-hints": {
              "format": "textarea"
            }
          },
          "parse_mode": {
            "type": "string",
            "title": "Parse Mode",
            "description": "Mode for parsing entities in the message text",
            "enum": [
              "Markdown",
              "MarkdownV2",
              "HTML"
            ],
            "enumNames": [
              "Markdown",
              "Markdown V2",
              "HTML"
            ],
            "ui": {
              "section": "Main",
              "order": 4
            },
            "x-ui-hints": {
              "format": "select"
            }
          },
          "disable_web_page_preview": {
            "type": "boolean",
            "title": "Disable Web Page Preview",
            "description": "Disables link previews for links in this message",
            "default": false,
            "ui": {
              "section": "Advanced",
              "order": 1
            }
          },
          "disable_notification": {
            "type": "boolean",
            "title": "Silent Message",
            "description": "Sends the message silently. Users will receive a notification with no sound.",
            "default": false,
            "ui": {
              "section": "Advanced",
              "order": 2
            }
          },
          "protect_content": {
            "type": "boolean",
            "title": "Protect Content",
            "description": "Protects the contents of the sent message from forwarding and saving",
            "default": false,
            "ui": {
              "section": "Advanced",
              "order": 3
            }
          },
          "reply_to_message_id": {
            "type": "integer",
            "title": "Reply to Message ID",
            "description": "If the message is a reply, ID of the original message",
            "ui": {
              "section": "Advanced",
              "order": 4
            }
          },
          "allow_sending_without_reply": {
            "type": "boolean",
            "title": "Allow Sending Without Reply",
            "description": "Pass True if the message should be sent even if the specified replied-to message is not found",
            "default": false,
            "ui": {
              "section": "Advanced",
              "order": 5
            }
          },
          "reply_markup": {
            "type": "object",
            "title": "Reply Markup",
            "description": "Additional interface options (inline keyboard, custom reply keyboard, etc.)",
            "ui": {
              "section": "Advanced",
              "order": 6
            },
            "x-ui-hints": {
              "format": "json-editor"
            }
          }
        }
      },
      "result_schema": {
        "type": "object",
        "properties": {
          "ok": {
            "type": "boolean",
            "description": "True if the request was successful"
          },
          "result": {
            "type": "object",
            "properties": {
              "message_id": {
                "type": "integer",
                "description": "Unique message identifier"
              },
              "chat": {
                "type": "object",
                "description": "Chat information"
              },
              "date": {
                "type": "integer",
                "description": "Date the message was sent in Unix time"
              },
              "text": {
                "type": "string",
                "description": "The sent message text"
              }
            }
          }
        }
      },
      "output_view": {
        "type": "key_value",
        "fields": [
          {
            "key": "ok",
            "label": "Success"
          },
          {
            "key": "result.message_id",
            "label": "Message ID"
          },
          {
            "key": "result.date",
            "label": "Date"
          },
          {
            "key": "result.text",
            "label": "Text Sent"
          }
        ]
      },
      "example_parameters": {
        "bot_token": "123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11",
        "chat_id": "123456789",
        "text": "Hello from Studio workflow!",
        "parse_mode": "Markdown"
      },
      "ui_hints": {
        "sections": {
          "Main": {
            "title": "Main",
            "collapsed": false,
            "order": 1
          },
          "Advanced": {
            "title": "Advanced",
            "collapsed": true,
            "order": 2
          }
        },
        "categories": [
          "communication"
        ]
      }
    },
    "telegram_send_photo": {
      "display_name": "Send Photo",
      "description": "Send a photo to a Telegram chat or channel. Supports captions, reply markup, and photo URLs or file IDs.",
      "service_type": "COMMUNICATION",
      "endpoint_url": "https://api.telegram.org/bot{bot_token}",
      "path": "/sendPhoto",
      "method": "POST",
      "requires_credentials": true,
      "parameter_mapping": {
        "path": [
