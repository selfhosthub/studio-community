    "trello_create_card": {
      "display_name": "Create Card",
      "description": "Create a new card in a Trello list. Set name, description, due date, labels, and members.",
      "service_type": "PRODUCTIVITY",
      "endpoint_url": "https://api.trello.com/1",
      "path": "/cards",
      "method": "POST",
      "requires_credentials": true,
      "parameter_mapping": {
        "query": [
          "idList",
          "name",
          "desc",
          "pos",
          "due",
          "dueComplete",
          "idMembers",
          "idLabels",
          "urlSource"
        ]
      },
      "parameter_schema": {
        "type": "object",
        "required": [
          "idList",
          "name"
        ],
        "properties": {
          "board_id": {
            "type": "string",
            "title": "Board",
            "description": "Select the board containing your target list",
            "ui": {
              "section": "Main",
              "order": 1
            },
            "x-ui-hints": {
              "ui_only": true
            },
            "dynamicOptions": {
              "service": "trello_get_my_boards",
              "optionsPath": "",
              "valueField": "id",
              "labelField": "name"
            }
          },
          "idList": {
            "type": "string",
            "title": "List",
            "description": "Select the list where the card should be created",
            "ui": {
              "section": "Main",
              "order": 2
            },
            "dynamicOptions": {
              "service": "trello_get_lists",
              "optionsPath": "",
              "valueField": "id",
              "labelField": "name",
              "dependsOn": {
                "field": "board_id",
                "param": "board_id"
              }
            }
          },
          "name": {
            "type": "string",
            "title": "Card Name",
            "description": "The name/title of the card",
            "examples": [
              "New task from workflow"
            ],
            "ui": {
              "section": "Main",
              "order": 3
            }
          },
          "desc": {
            "type": "string",
            "title": "Description",
            "description": "The description/body of the card (supports Markdown)",
            "ui": {
              "section": "Main",
              "order": 4
            },
            "x-ui-hints": {
              "format": "textarea"
            }
          },
          "pos": {
            "type": "string",
            "title": "Position",
            "description": "Position of the card in the list",
            "enum": [
              "top",
              "bottom"
            ],
            "default": "bottom",
            "ui": {
              "section": "Advanced",
              "order": 1
            },
            "x-ui-hints": {
              "format": "select"
            }
          },
          "due": {
            "type": "string",
            "format": "date-time",
            "title": "Due Date",
            "description": "Due date in ISO 8601 format",
            "examples": [
              "2024-12-31T23:59:59Z"
            ],
            "ui": {
              "section": "Advanced",
              "order": 2
            }
          },
          "dueComplete": {
            "type": "boolean",
            "title": "Due Complete",
            "description": "Whether the due date has been marked complete",
            "default": false,
            "ui": {
              "section": "Advanced",
              "order": 3
            }
          },
          "idMembers": {
            "type": "string",
            "title": "Member IDs",
            "description": "Comma-separated list of member IDs to assign",
            "examples": [
              "member1,member2"
            ],
            "ui": {
              "section": "Advanced",
              "order": 4
            }
          },
          "idLabels": {
            "type": "string",
            "title": "Label IDs",
            "description": "Comma-separated list of label IDs to apply",
            "examples": [
              "label1,label2"
            ],
            "ui": {
              "section": "Advanced",
              "order": 5
            }
          },
          "urlSource": {
            "type": "string",
            "title": "URL Source",
            "description": "URL to attach to the card",
            "format": "uri",
            "ui": {
              "section": "Advanced",
              "order": 6
            }
          }
        }
      },
      "result_schema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "The ID of the created card"
          },
          "name": {
            "type": "string"
          },
          "desc": {
            "type": "string"
          },
          "url": {
            "type": "string",
            "description": "Direct URL to the card"
          },
          "idList": {
            "type": "string"
          }
        }
      },
      "output_view": {
        "type": "key_value",
        "fields": [
          {
            "key": "id",
            "label": "Card ID"
          },
          {
            "key": "name",
            "label": "Name"
          },
          {
            "key": "url",
            "label": "URL"
          },
          {
            "key": "idList",
            "label": "List ID"
          }
        ]
      },
      "example_parameters": {
        "idList": "60a1b2c3d4e5f6a7b8c9d0e1",
        "name": "New task from workflow",
        "desc": "Created automatically by Studio"
      },
      "ui_hints": {
        "sections": {
          "Main": {
            "title": "Main",
            "collapsed": false,
            "order": 1
          },
          "Advanced": {
            "title": "Advanced",
            "collapsed": true,
            "order": 2
          }
        },
        "categories": [
          "productivity"
        ]
      }
    },
