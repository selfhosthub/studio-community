{
  "$schema": "https://raw.githubusercontent.com/selfhosthub/studio-community/main/schemas/provider.schema.json",
  "slug": "shs/trello",
  "version": "1.0.0",
  "name": "Trello",
  "description": "Project management with boards, lists, and cards",
  "provider_type": "API",
  "category": "productivity",
  "status": "ACTIVE",
  "tier": "community",
  "credential_provider": null,
  "requires": [],
  "services_preview": [
    "Get Board",
    "List Cards",
    "Create Card",
    "Update Card"
  ],
  "credential_schema": {
    "type": "object",
    "required": [
      "api_key",
      "api_token"
    ],
    "x-ui-hints": {
      "instructions": "Trello requires an API Key and Token. Follow the steps below to get both."
    },
    "properties": {
      "api_key": {
        "type": "string",
        "title": "API Key",
        "description": "Create a Power-Up or use an existing one to get your API Key",
        "format": "password",
        "x-ui-hints": {
          "step": 1,
          "step_title": "Get your API Key",
          "help_url": "https://trello.com/power-ups/admin",
          "help_link_text": "Open Trello Power-Ups Admin"
        }
      },
      "api_token": {
        "type": "string",
        "title": "API Token",
        "description": "Click 'Allow' on the Trello page, then copy the token shown",
        "format": "password",
        "x-ui-hints": {
          "step": 2,
          "step_title": "Generate your Token",
          "depends_on": "api_key",
          "generate_url_template": "https://trello.com/1/authorize?expiration=never&scope=read,write&response_type=token&key={api_key}",
          "generate_button_text": "Generate Token",
          "help_text": "Token never expires (permanent access)"
        }
      }
    }
  },
  "base_url": "https://api.trello.com/1",
  "auth": {
    "type": "custom",
    "config": {
      "fields": {
        "api_key": "key",
        "api_token": "token"
      }
    }
  },
  "default_headers": {
    "Accept": "application/json"
  },
  "services": {
    "trello_get_board": {
      "display_name": "Get Board",
      "description": "Retrieve board information including lists, cards, members, and settings. Use to understand board structure.",
      "service_type": "PRODUCTIVITY",
      "endpoint_url": "https://api.trello.com/1",
      "path": "/boards/{board_id}",
      "method": "GET",
      "requires_credentials": true,
      "parameter_mapping": {
        "path": [
          "board_id"
        ],
        "query": [
          "fields",
          "lists",
          "cards",
          "members"
        ]
      },
      "parameter_schema": {
        "type": "object",
        "required": [
          "board_id"
        ],
        "properties": {
          "board_id": {
            "type": "string",
            "title": "Board ID",
            "description": "The ID or short name of the board",
            "examples": [
              "abc123",
              "myboard"
            ],
            "ui": {
              "section": "Main",
              "order": 1
            }
          },
          "fields": {
            "type": "string",
            "title": "Fields",
            "description": "Comma-separated list of fields to include (all, name, desc, url, etc.)",
            "default": "all",
            "ui": {
              "section": "Advanced",
              "order": 1
            }
          },
          "lists": {
            "type": "string",
            "title": "Include Lists",
            "description": "Whether to include lists (all, open, closed, none)",
            "enum": [
              "all",
              "open",
              "closed",
              "none"
            ],
            "default": "none",
            "ui": {
              "section": "Advanced",
              "order": 2
            },
            "x-ui-hints": {
              "format": "select"
            }
          },
          "cards": {
            "type": "string",
            "title": "Include Cards",
            "description": "Whether to include cards (all, open, closed, visible, none)",
            "enum": [
              "all",
              "open",
              "closed",
              "visible",
              "none"
            ],
            "default": "none",
            "ui": {
              "section": "Advanced",
              "order": 3
            },
            "x-ui-hints": {
              "format": "select"
            }
          },
          "members": {
            "type": "string",
            "title": "Include Members",
            "description": "Whether to include board members (all, none)",
            "enum": [
              "all",
              "none"
            ],
            "default": "none",
            "ui": {
              "section": "Advanced",
              "order": 4
            },
            "x-ui-hints": {
              "format": "select"
            }
          }
        }
      },
      "result_schema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "desc": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "lists": {
            "type": "array"
          },
          "cards": {
            "type": "array"
          }
        }
      },
      "output_view": {
        "type": "key_value",
        "fields": [
          {
            "key": "id",
            "label": "Board ID"
          },
          {
            "key": "name",
            "label": "Name"
          },
          {
            "key": "desc",
            "label": "Description"
          },
          {
            "key": "url",
            "label": "URL"
          }
        ]
      },
      "example_parameters": {
        "board_id": "abc123",
        "lists": "open",
        "cards": "open"
      },
      "ui_hints": {
        "sections": {
          "Main": {
            "title": "Main",
            "collapsed": false,
            "order": 1
          },
          "Advanced": {
            "title": "Advanced",
            "collapsed": true,
            "order": 2
          }
        },
        "categories": [
          "productivity"
        ]
      }
    },
    "trello_list_cards": {
      "display_name": "List Cards",
      "description": "Get cards from a board or list. Filter by status, labels, members, and more.",
      "service_type": "PRODUCTIVITY",
      "endpoint_url": "https://api.trello.com/1",
      "path": "/boards/{board_id}/cards",
      "method": "GET",
      "requires_credentials": true,
      "parameter_mapping": {
        "path": [
          "board_id"
        ],
        "query": [
          "filter",
          "fields",
          "members",
          "attachments",
          "checklists"
        ]
      },
      "parameter_schema": {
        "type": "object",
        "required": [
          "board_id"
        ],
        "properties": {
          "board_id": {
            "type": "string",
            "title": "Board ID",
            "description": "The ID of the board",
            "examples": [
              "abc123"
            ],
            "ui": {
              "section": "Main",
              "order": 1
            }
          },
          "filter": {
            "type": "string",
            "title": "Filter",
            "description": "Card status filter",
            "enum": [
              "all",
              "open",
              "closed",
              "visible"
            ],
            "default": "open",
            "ui": {
              "section": "Main",
              "order": 2
            },
            "x-ui-hints": {
              "format": "select"
            }
          },
          "fields": {
            "type": "string",
            "title": "Fields",
            "description": "Comma-separated list of card fields to include",
            "examples": [
              "name,desc,due,labels,idList"
            ],
            "ui": {
              "section": "Advanced",
              "order": 1
            }
          },
          "members": {
            "type": "boolean",
            "title": "Include Members",
            "description": "Include member details",
            "default": false,
            "ui": {
              "section": "Advanced",
              "order": 2
            }
          },
          "attachments": {
            "type": "boolean",
            "title": "Include Attachments",
            "description": "Include card attachments",
            "default": false,
            "ui": {
              "section": "Advanced",
              "order": 3
            }
          },
          "checklists": {
            "type": "string",
            "title": "Include Checklists",
            "description": "Include card checklists (all or none)",
            "enum": [
              "all",
              "none"
            ],
            "default": "none",
            "ui": {
              "section": "Advanced",
              "order": 4
            },
            "x-ui-hints": {
              "format": "select"
            }
          }
        }
      },
      "result_schema": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string"
            },
            "name": {
              "type": "string"
            },
            "desc": {
              "type": "string"
            },
            "due": {
              "type": "string"
            },
            "idList": {
              "type": "string"
            },
            "labels": {
              "type": "array"
            }
          }
        }
      },
      "output_view": {
        "type": "table",
        "source": "",
        "columns": [
          {
            "key": "id",
            "label": "Card ID"
          },
          {
            "key": "name",
            "label": "Name"
          },
          {
            "key": "due",
            "label": "Due Date"
          },
          {
            "key": "idList",
            "label": "List ID"
          }
        ]
      },
      "example_parameters": {
        "board_id": "abc123",
        "filter": "open"
      },
      "ui_hints": {
        "sections": {
          "Main": {
            "title": "Main",
            "collapsed": false,
            "order": 1
          },
          "Advanced": {
            "title": "Advanced",
            "collapsed": true,
            "order": 2
          }
        },
        "categories": [
          "productivity"
        ]
      }
    },
