    "twilio_make_call": {
      "display_name": "Make Call",
      "description": "Initiate an outbound voice call. Requires a TwiML URL or TwiML content that instructs Twilio what to do when the call connects (e.g. play audio, say text, gather input).",
      "service_type": "COMMUNICATION",
      "endpoint_url": "https://api.twilio.com/2010-04-01/Accounts/{account_sid}/Calls.json",
      "method": "POST",
      "requires_credentials": true,
      "parameter_mapping": {
        "path": [
          "account_sid"
        ],
        "body": [
          "To",
          "From",
          "Url",
          "Twiml",
          "StatusCallback",
          "StatusCallbackEvent",
          "Timeout",
          "Record",
          "MachineDetection"
        ]
      },
      "parameter_schema": {
        "type": "object",
        "required": [
          "account_sid",
          "auth_token",
          "To",
          "From"
        ],
        "properties": {
          "account_sid": {
            "type": "string",
            "title": "Account SID",
            "description": "Your Twilio Account SID",
            "ui": {
              "section": "Main",
              "order": 1
            },
            "x-ui-hints": {
              "format": "credential_field"
            }
          },
          "auth_token": {
            "type": "string",
            "title": "Auth Token",
            "description": "Your Twilio Auth Token",
            "ui": {
              "section": "Main",
              "order": 2
            },
            "x-ui-hints": {
              "format": "credential_field"
            }
          },
          "To": {
            "type": "string",
            "title": "To",
            "description": "Phone number to call in E.164 format",
            "examples": [
              "+15551234567"
            ],
            "ui": {
              "section": "Main",
              "order": 3
            }
          },
          "From": {
            "type": "string",
            "title": "From",
            "description": "Your Twilio phone number in E.164 format",
            "examples": [
              "+15559876543"
            ],
            "ui": {
              "section": "Main",
              "order": 4
            }
          },
          "Url": {
            "type": "string",
            "title": "TwiML URL",
            "description": "URL returning TwiML instructions for the call. Required if Twiml is not set.",
            "format": "uri",
            "ui": {
              "section": "Main",
              "order": 5
            }
          },
          "Twiml": {
            "type": "string",
            "title": "TwiML Content",
            "description": "Inline TwiML XML instructions. Required if Url is not set.",
            "examples": [
              "<Response><Say>Hello from Studio!</Say></Response>"
            ],
            "ui": {
              "section": "Main",
              "order": 6
            },
            "x-ui-hints": {
              "format": "textarea"
            }
          },
          "StatusCallback": {
            "type": "string",
            "title": "Status Callback URL",
            "description": "URL to receive call status webhooks",
            "format": "uri",
            "ui": {
              "section": "Advanced",
              "order": 1
            }
          },
          "StatusCallbackEvent": {
            "type": "array",
            "title": "Status Callback Events",
            "description": "Call events to send to the status callback",
            "items": {
              "type": "string",
              "enum": [
                "initiated",
                "ringing",
                "answered",
                "completed"
              ]
            },
            "ui": {
              "section": "Advanced",
              "order": 2
            },
            "x-ui-hints": {
              "format": "multi-select"
            }
          },
          "Timeout": {
            "type": "integer",
            "title": "Timeout",
            "description": "Seconds to wait for answer before giving up (default 60)",
            "minimum": 5,
            "maximum": 600,
            "default": 60,
            "ui": {
              "section": "Advanced",
              "order": 3
            }
          },
          "Record": {
            "type": "boolean",
            "title": "Record Call",
            "description": "Whether to record the entire call",
            "default": false,
            "ui": {
              "section": "Advanced",
              "order": 4
            }
          },
          "MachineDetection": {
            "type": "string",
            "title": "Answering Machine Detection",
            "description": "Enable answering machine detection",
            "enum": [
              "Enable",
              "DetectMessageEnd"
            ],
            "enumNames": [
              "Enable",
              "Detect Message End"
            ],
            "ui": {
              "section": "Advanced",
              "order": 5
            },
            "x-ui-hints": {
              "format": "select"
            }
          }
        }
      },
      "result_schema": {
        "type": "object",
        "properties": {
          "sid": {
            "type": "string",
            "description": "Unique call identifier (e.g. CA...)"
          },
          "status": {
            "type": "string",
            "description": "Call status: queued, ringing, in-progress, completed, busy, no-answer, canceled, failed"
          },
          "to": {
            "type": "string",
            "description": "Called phone number"
          },
          "from": {
            "type": "string",
            "description": "Caller phone number"
          },
          "direction": {
            "type": "string",
            "description": "Call direction: outbound-api"
          },
          "date_created": {
            "type": "string",
            "description": "RFC 2822 date string"
          },
          "duration": {
            "type": [
              "string",
              "null"
            ],
            "description": "Call duration in seconds (null if not yet completed)"
          },
          "price": {
            "type": [
              "string",
              "null"
            ],
            "description": "Cost of the call"
          }
        }
      },
      "output_view": {
        "type": "key_value",
        "fields": [
          {
            "key": "sid",
            "label": "Call SID"
          },
          {
            "key": "status",
            "label": "Status"
          },
          {
            "key": "to",
            "label": "To"
          },
          {
            "key": "from",
            "label": "From"
          },
          {
            "key": "direction",
            "label": "Direction"
          }
        ]
      },
      "example_parameters": {
        "account_sid": "ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx",
        "auth_token": "your_auth_token",
        "To": "+15551234567",
        "From": "+15559876543",
        "Twiml": "<Response><Say>Hello from Studio!</Say></Response>"
      },
      "ui_hints": {
        "sections": {
          "Main": {
            "title": "Main",
            "collapsed": false,
            "order": 1
          },
          "Advanced": {
            "title": "Advanced",
            "collapsed": true,
            "order": 2
          }
        },
        "categories": [
          "communication"
        ]
      }
    },
