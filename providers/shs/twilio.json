    "twilio_get_message": {
      "display_name": "Get Message",
      "description": "Retrieve details of a single message by its SID, including delivery status, price, and error information.",
      "service_type": "COMMUNICATION",
      "endpoint_url": "https://api.twilio.com/2010-04-01/Accounts/{account_sid}/Messages/{message_sid}.json",
      "method": "GET",
      "requires_credentials": true,
      "parameter_mapping": {
        "path": [
          "account_sid",
          "message_sid"
        ]
      },
      "parameter_schema": {
        "type": "object",
        "required": [
          "account_sid",
          "auth_token",
          "message_sid"
        ],
        "properties": {
          "account_sid": {
            "type": "string",
            "title": "Account SID",
            "description": "Your Twilio Account SID",
            "ui": {
              "section": "Main",
              "order": 1
            },
            "x-ui-hints": {
              "format": "credential_field"
            }
          },
          "auth_token": {
            "type": "string",
            "title": "Auth Token",
            "description": "Your Twilio Auth Token",
            "ui": {
              "section": "Main",
              "order": 2
            },
            "x-ui-hints": {
              "format": "credential_field"
            }
          },
          "message_sid": {
            "type": "string",
            "title": "Message SID",
            "description": "The SID of the message to retrieve (e.g. SM...)",
            "examples": [
              "SM1234567890abcdef1234567890abcdef"
            ],
            "ui": {
