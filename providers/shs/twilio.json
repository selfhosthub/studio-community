{
  "$schema": "https://raw.githubusercontent.com/selfhosthub/studio-community/main/schemas/provider.schema.json",
  "slug": "shs/twilio",
  "version": "1.0.0",
  "name": "Twilio",
  "description": "SMS, WhatsApp, and voice call automation via Twilio",
  "provider_type": "API",
  "category": "communication",
  "status": "ACTIVE",
  "tier": "community",
  "credential_provider": null,
  "requires": [],
  "services_preview": [
    "Send SMS",
    "Send WhatsApp",
    "Make Call",
    "List Messages",
    "Get Message"
  ],
  "credential_schema": {
    "type": "object",
    "required": [
      "account_sid",
      "auth_token"
    ],
    "properties": {
      "account_sid": {
        "type": "string",
        "title": "Account SID",
        "description": "Your Twilio Account SID from the console dashboard"
      },
      "auth_token": {
        "type": "string",
        "title": "Auth Token",
        "description": "Your Twilio Auth Token from the console dashboard",
        "format": "password"
      },
      "from_number": {
        "type": "string",
        "title": "From Number",
        "description": "Your Twilio phone number (e.g. +15551234567)"
      }
    }
  },
  "base_url": null,
  "auth": {
    "type": "custom",
    "config": {
      "token_location": "header",
      "scheme": "basic",
      "basic_auth_fields": [
        "account_sid",
        "auth_token"
      ]
    }
  },
  "default_headers": {
    "Content-Type": "application/x-www-form-urlencoded"
  },
  "services": {
    "twilio_send_sms": {
      "display_name": "Send SMS",
      "description": "Send an SMS message to any phone number. Supports standard SMS up to 1600 characters with automatic segmentation for longer messages.",
      "service_type": "COMMUNICATION",
      "endpoint_url": "https://api.twilio.com/2010-04-01/Accounts/{account_sid}/Messages.json",
      "method": "POST",
      "requires_credentials": true,
      "parameter_mapping": {
        "path": [
          "account_sid"
        ],
        "body": [
          "To",
          "From",
          "Body",
          "StatusCallback",
          "MessagingServiceSid"
        ]
      },
      "parameter_schema": {
        "type": "object",
        "required": [
          "account_sid",
          "auth_token",
          "To",
          "From",
          "Body"
        ],
        "properties": {
          "account_sid": {
            "type": "string",
            "title": "Account SID",
            "description": "Your Twilio Account SID",
            "ui": {
              "section": "Main",
              "order": 1
            },
            "x-ui-hints": {
              "format": "credential_field"
            }
          },
          "auth_token": {
            "type": "string",
            "title": "Auth Token",
            "description": "Your Twilio Auth Token",
            "ui": {
              "section": "Main",
              "order": 2
            },
            "x-ui-hints": {
              "format": "credential_field"
            }
          },
          "To": {
            "type": "string",
            "title": "To",
            "description": "Destination phone number in E.164 format (e.g. +15551234567)",
            "examples": [
              "+15551234567"
            ],
            "ui": {
              "section": "Main",
              "order": 3
            }
          },
          "From": {
            "type": "string",
            "title": "From",
            "description": "Your Twilio phone number in E.164 format (e.g. +15559876543)",
            "examples": [
              "+15559876543"
            ],
            "ui": {
              "section": "Main",
              "order": 4
            }
          },
          "Body": {
            "type": "string",
            "title": "Message Body",
            "description": "Text content of the SMS message, up to 1600 characters",
            "maxLength": 1600,
            "ui": {
              "section": "Main",
              "order": 5
            },
            "x-ui-hints": {
              "format": "textarea"
            }
          },
          "StatusCallback": {
            "type": "string",
            "title": "Status Callback URL",
            "description": "URL to receive message status webhooks (queued, sent, delivered, failed)",
            "format": "uri",
            "ui": {
              "section": "Advanced",
              "order": 1
            }
          },
          "MessagingServiceSid": {
            "type": "string",
            "title": "Messaging Service SID",
            "description": "Optional Messaging Service SID for sender pool routing",
            "ui": {
              "section": "Advanced",
              "order": 2
            }
          }
        }
      },
      "result_schema": {
        "type": "object",
        "properties": {
          "sid": {
            "type": "string",
            "description": "Unique message identifier (e.g. SM...)"
          },
          "status": {
            "type": "string",
            "description": "Message status: queued, sending, sent, delivered, undelivered, failed"
          },
          "to": {
            "type": "string",
            "description": "Destination phone number"
          },
          "from": {
            "type": "string",
            "description": "Sender phone number"
          },
          "body": {
            "type": "string",
            "description": "Message body text"
          },
          "date_created": {
            "type": "string",
            "description": "RFC 2822 date string"
          },
          "price": {
            "type": "string",
            "description": "Cost of the message"
          },
          "error_code": {
            "type": [
              "integer",
              "null"
            ],
            "description": "Twilio error code if failed"
          },
          "error_message": {
            "type": [
              "string",
              "null"
            ],
            "description": "Error description if failed"
          }
        }
      },
      "output_view": {
        "type": "key_value",
        "fields": [
          {
            "key": "sid",
            "label": "Message SID"
          },
          {
            "key": "status",
            "label": "Status"
          },
          {
            "key": "to",
            "label": "To"
          },
          {
            "key": "from",
            "label": "From"
          },
          {
            "key": "date_created",
            "label": "Created"
          }
        ]
      },
      "example_parameters": {
        "account_sid": "ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx",
        "auth_token": "your_auth_token",
        "To": "+15551234567",
        "From": "+15559876543",
        "Body": "Hello from Studio workflow!"
      },
      "ui_hints": {
        "sections": {
          "Main": {
            "title": "Main",
            "collapsed": false,
            "order": 1
          },
          "Advanced": {
            "title": "Advanced",
            "collapsed": true,
            "order": 2
          }
        },
        "categories": [
          "communication"
        ]
      }
    },
    "twilio_send_whatsapp": {
