{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://raw.githubusercontent.com/selfhosthub/studio-community/main/schemas/workflow.schema.json",
  "version": "1.0.0",
  "title": "Studio Workflow",
  "description": "A complete workflow definition with steps forming a directed acyclic graph.\n\nStability: future versions of this schema must remain backward-compatible with content authored against earlier versions of itself \u2014 once a package is published with a given version, it must continue to validate against the schema in force at install time. Add fields conservatively (optional first); promote to required only with a major schema revision and a migration story.",
  "type": "object",
  "required": [
    "name",
    "description",
    "version",
    "author",
    "steps"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "author": {
      "type": "string"
    },
    "requires": {
      "type": "array",
      "description": "Provider slugs required to run this workflow.",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]*/[a-z][a-z0-9-]*$"
      },
      "default": []
    },
    "prompts": {
      "type": "array",
      "description": "Marketplace prompt templates used by this workflow.",
      "items": {
        "$ref": "#/$defs/promptReference"
      }
    },
    "steps": {
      "type": "object",
      "description": "Step definitions keyed by step ID. Forms a DAG via depends_on.",
      "additionalProperties": {
        "$ref": "#/$defs/step"
      }
    },
    "trigger_type": {
      "type": "string",
      "description": "How the workflow is triggered.",
      "enum": [
        "manual",
        "schedule",
        "webhook",
        "event",
        "api"
      ],
      "default": "manual"
    },
    "trigger_input_schema": {
      "type": "object",
      "description": "Expected fields on the trigger payload.",
      "additionalProperties": true
    },
    "webhook_method": {
      "type": "string",
      "description": "HTTP method the webhook trigger accepts.",
      "enum": [
        "POST",
        "GET"
      ],
      "default": "POST"
    },
    "webhook_auth_type": {
      "type": "string",
      "description": "How an inbound webhook request is authenticated. signed_raw_body is parameterised by webhook_config.auth.",
      "enum": [
        "none",
        "header",
        "jwt",
        "hmac",
        "signed_raw_body"
      ],
      "default": "none"
    },
    "webhook_auth_header_name": {
      "type": "string",
      "description": "Header carrying the shared value for header auth. Never the value itself."
    },
    "webhook_config": {
      "type": "object",
      "description": "Non-secret webhook trigger configuration. No credential belongs here: the signing secret is an organization secret, never a catalog field.",
      "additionalProperties": false,
      "properties": {
        "auth": {
          "type": "object",
          "description": "Signature verification parameters for signed_raw_body.",
          "additionalProperties": false,
          "required": [
            "signature_header",
            "signed_template",
            "algorithm"
          ],
          "properties": {
            "signature_header": {
              "type": "string",
              "description": "Header carrying the signature."
            },
            "timestamp_header": {
              "type": "string",
              "description": "Header carrying the signing timestamp. Required when signed_template names {timestamp}."
            },
            "signature_prefix": {
              "type": "string",
              "description": "Literal prefix stripped from the header before comparison, e.g. \"v0=\"."
            },
            "signed_template": {
              "type": "string",
              "description": "String that is signed, with {timestamp} and {body} substituted."
            },
            "max_age_seconds": {
              "type": "integer",
              "description": "Accepted clock skew in either direction. Required when signed_template names {timestamp}.",
              "minimum": 1
            },
            "algorithm": {
              "type": "string",
              "enum": [
                "sha1",
                "sha256",
                "sha512"
              ]
            }
          }
        },
        "handshake": {
          "type": "object",
          "description": "The sender's URL-verification echo.",
          "additionalProperties": false,
          "required": [
            "match_field",
            "match_value",
            "echo_field"
          ],
          "properties": {
            "match_field": {
              "type": "string",
              "description": "Body field identifying a handshake request."
            },
            "match_value": {
              "type": "string",
              "description": "Value of match_field that marks a handshake."
            },
            "echo_field": {
              "type": "string",
              "description": "Body field whose value is echoed back."
            }
          }
        }
      }
    },
    "client_metadata": {
      "type": "object",
      "description": "Frontend-owned metadata (experience_config, etc.). Not validated by the backend.",
      "additionalProperties": true
    }
  },
  "$defs": {
    "step": {
      "type": "object",
      "required": [
        "name"
      ],
      "additionalProperties": true,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "type": {
          "type": "string",
          "description": "Step type. Maps to step_type in the backend.",
          "enum": [
            "trigger",
            "task"
          ],
          "default": "task"
        },
        "depends_on": {
          "type": "array",
          "description": "Step IDs this step depends on. __instance_form__ is a virtual step for user input.",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "ui_config": {
          "$ref": "#/$defs/uiConfig"
        },
        "job": {
          "$ref": "#/$defs/job"
        },
        "timeout": {
          "type": "integer",
          "description": "Timeout in seconds.",
          "minimum": 1
        },
        "trigger_type": {
          "type": "string",
          "description": "How the step is triggered.",
          "enum": [
            "manual",
            "auto"
          ],
          "default": "auto"
        },
        "outputs": {
          "type": "object",
          "description": "Output field extraction configuration.",
          "additionalProperties": {
            "$ref": "#/$defs/outputField"
          }
        },
        "input_mappings": {
          "type": "object",
          "description": "Parameter mappings from other steps, prompts, or forms. Keys can be param names, nested paths (scenes[0].elements[0].src), or _prompt_variable: prefixed.",
          "additionalProperties": {
            "$ref": "#/$defs/inputMapping"
          }
        },
        "iteration_config": {
          "$ref": "#/$defs/iterationConfig"
        },
        "config": {
          "type": "object",
          "description": "Step-level configuration (secret_id, parameter_ui_state, etc.).",
          "additionalProperties": true
        },
        "output_forwarding": {
          "$ref": "#/$defs/outputForwarding"
        },
        "service_type": {
          "type": "string",
          "description": "Service category. Sometimes at step level instead of inside job."
        },
        "retry_count": {
          "type": "integer",
          "default": 0,
          "minimum": 0
        },
        "retry_delay_seconds": {
          "type": "integer",
          "default": 60,
          "minimum": 0
        },
        "is_required": {
          "type": "boolean",
          "default": true
        },
        "on_failure": {
          "type": "string",
          "enum": [
            "fail_workflow",
            "continue",
            "retry"
          ],
          "default": "fail_workflow"
        },
        "condition": {
          "type": "string",
          "description": "Conditional execution expression."
        }
      }
    },
    "job": {
      "type": "object",
      "description": "Job execution configuration.",
      "additionalProperties": true,
      "properties": {
        "service_type": {
          "type": "string",
          "description": "Service category (ai, core, transform, SOCIAL_MEDIA, etc.)."
        },
        "provider_id": {
          "type": "string",
          "description": "Provider slug (converted to UUID at seed time)."
        },
        "service_id": {
          "type": "string",
          "description": "Service identifier, e.g. openai.openai_chat."
        },
        "parameters": {
          "type": "object",
          "description": "Service-specific parameters.",
          "additionalProperties": true
        }
      }
    },
    "inputMapping": {
      "type": "object",
      "required": [
        "mappingType"
      ],
      "additionalProperties": true,
      "properties": {
        "mappingType": {
          "type": "string",
          "description": "How the parameter value is resolved.",
          "enum": [
            "static",
            "mapped",
            "form",
            "prompt"
          ]
        },
        "stepId": {
          "type": "string",
          "description": "Source step ID for mapped type. __instance_form__ for user input."
        },
        "outputField": {
          "type": "string",
          "description": "Field from source step's outputs (mapped type)."
        },
        "promptSlug": {
          "type": "string",
          "description": "Marketplace prompt slug (prompt type)."
        },
        "formField": {
          "type": "string",
          "description": "Form field name (form type)."
        },
        "staticValue": {
          "description": "Static value (static type)."
        },
        "path": {
          "type": "string",
          "description": "Path expression for nested data access (.url, [0].url, [*].url, [*] with element_mapping)."
        },
        "element_mapping": {
          "type": "object",
          "description": "Field mapping for array transforms when path is [*].",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    },
    "iterationConfig": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": false
        },
        "source_step_id": {
          "type": "string",
          "description": "Step that provides the array to iterate over."
        },
        "source_output_field": {
          "type": "string",
          "description": "Output field containing the array."
        },
        "target_parameter": {
          "type": "string",
          "description": "Parameter that receives each array element."
        },
        "execution_mode": {
          "type": "string",
          "enum": [
            "sequential",
            "parallel"
          ],
          "default": "sequential"
        },
        "estimated_count": {
          "type": "integer",
          "description": "Estimated array size for resource planning.",
          "minimum": 0
        },
        "accumulators": {
          "type": "array",
          "description": "Accumulator definitions for sequential mode.",
          "items": {
            "type": "object",
            "required": [
              "field_name",
              "expression"
            ],
            "additionalProperties": false,
            "properties": {
              "field_name": {
                "type": "string"
              },
              "expression": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "outputForwarding": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "mode": {
          "type": "string",
          "enum": [
            "all",
            "selected"
          ]
        },
        "selected_fields": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "outputField": {
      "type": "object",
      "required": [
        "path",
        "type"
      ],
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string",
          "description": "JSONPath-like expression to extract from the service response."
        },
        "type": {
          "type": "string",
          "enum": [
            "string",
            "number",
            "boolean",
            "object",
            "array"
          ]
        },
        "description": {
          "type": "string"
        },
        "items": {
          "type": "object",
          "description": "JSON-Schema style description of array elements; descriptive only, not consumed by the product."
        }
      }
    },
    "uiConfig": {
      "type": "object",
      "description": "Visual editor configuration.",
      "additionalProperties": true,
      "properties": {
        "position": {
          "type": "object",
          "required": [
            "x",
            "y"
          ],
          "additionalProperties": false,
          "properties": {
            "x": {
              "type": "number"
            },
            "y": {
              "type": "number"
            }
          }
        }
      }
    },
    "promptReference": {
      "type": "object",
      "required": [
        "marketplace_slug",
        "used_by_step"
      ],
      "additionalProperties": false,
      "properties": {
        "marketplace_slug": {
          "type": "string",
          "description": "Marketplace prompt slug to install/resolve."
        },
        "used_by_step": {
          "type": "string",
          "description": "Step ID that uses this prompt."
        }
      }
    }
  }
}
