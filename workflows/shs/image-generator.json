{
  "name": "AI Image Generator",
  "description": "Generate AI images from text prompts using ComfyUI with customizable styles and batch sizes.",
  "version": "1.0.0",
  "author": "SelfHostHub",
  "requires": [
    "shs/comfyui"
  ],
  "steps": {
    "generate_images": {
      "name": "Generate Images",
      "description": "Generate images from a text prompt using ComfyUI",
      "type": "task",
      "depends_on": [],
      "ui_config": {
        "position": {
          "x": 100,
          "y": 200
        }
      },
      "job": {
        "provider_id": "shs/comfyui",
        "service_id": "shs/comfyui.comfyui_txt2img",
        "parameters": {
          "prompt": "",
          "model": "flux1-schnell-q4",
          "styles": [
            "sai-photographic"
          ],
          "output_width": 1024,
          "output_height": 1024,
          "steps": 4,
          "batch_size": 1,
          "seed": -1
        }
      },
      "input_mappings": {
        "prompt": {
          "mappingType": "form"
        },
        "batch_size": {
          "mappingType": "form"
        }
      },
      "timeout": 300,
      "outputs": {
        "downloaded_files": {
          "path": "downloaded_files",
          "type": "array",
          "description": "Array of generated image file URLs"
        }
      }
    }
  }
}
